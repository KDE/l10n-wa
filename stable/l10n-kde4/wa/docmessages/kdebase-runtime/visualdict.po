#. Tag: para
#: index.docbook:32
#, no-c-format
msgid ""
"A visual guide to &kde;'s interface. This is a very early version of the "
"document. Eventually, this will be a graphical tour of &kde;."
msgstr ""
"On guide vizuwel di l'&nbsp;eterface di &kde;. Çouchal c'&nbsp;est ene "
"prumire modêye do documint. Çoula crexhre po divni on toû grafike di &kde;."

#. Tag: keyword
#: index.docbook:38
#, no-c-format
msgid "<keyword>KDE</keyword>"
msgstr "<keyword>KDE</keyword>"

