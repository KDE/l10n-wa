#, no-c-format
msgid "<command>smart-home</command><arg>BOOL</arg>"
msgstr ""

#. Tag: para
#: configuring.docbook:1722
#, no-c-format
msgid "Set smart home navigation on or off."
msgstr ""

#. Tag: cmdsynopsis
#: configuring.docbook:1726
#, no-c-format
msgid "<command>space-indent</command><arg>BOOL</arg>"
msgstr ""

#. Tag: para
#: configuring.docbook:1727
#, no-c-format
msgid "Set indentation with spaces on or off."
msgstr ""

#. Tag: para
#: configuring.docbook:1728
#, no-c-format
msgid ""
"Note: Deprecated since Kate 3 in KDE4. Mixed indentation is the default "
"behavior. Set <command>replace-tabs on;</command> to achieve space-only "
"indentation."
msgstr ""

#. Tag: cmdsynopsis
#: configuring.docbook:1732
#, no-c-format
msgid "<command>tab-indents</command><arg>BOOL</arg>"
msgstr ""

#. Tag: para
#: configuring.docbook:1733
#, no-c-format
msgid "Set the TAB key indentation on or off."
msgstr ""

#. Tag: cmdsynopsis
#: configuring.docbook:1737
#, no-c-format
msgid "<command>tab-width</command><arg>INT</arg>"
msgstr ""

#. Tag: para
#: configuring.docbook:1738
#, no-c-format
msgid "Set the tab display width."
msgstr ""

#. Tag: cmdsynopsis
#: configuring.docbook:1742
#, no-c-format
msgid "<command>undo-steps</command><arg>INT</arg>"
msgstr ""

#. Tag: para
#: configuring.docbook:1743
#, no-c-format
msgid "Set the number of undo steps to remember."
msgstr ""

#. Tag: para
#: configuring.docbook:1744
#, no-c-format
msgid ""
"Note: Deprecated since Kate 3 in KDE4. This variable is ignored. The maximal "
"count of undo steps is unlimited."
msgstr ""

#. Tag: cmdsynopsis
#: configuring.docbook:1748
#, no-c-format
msgid "<command>word-wrap-column</command><arg>INT</arg>"
msgstr ""

#. Tag: para
#: configuring.docbook:1749
#, no-c-format
msgid "Set the hard word wrap width."
msgstr ""

#. Tag: cmdsynopsis
#: configuring.docbook:1753
#, no-c-format
msgid "<command>word-wrap-marker-color</command><arg>STRING</arg>"
msgstr ""

#. Tag: para
#: configuring.docbook:1754
#, no-c-format
msgid ""
"Set the word wrap marker color. The value must be something that can be "
"evaluated to a valid color, for example \"#ff0000\"."
msgstr ""

#. Tag: cmdsynopsis
#: configuring.docbook:1759
#, no-c-format
msgid "<command>word-wrap</command><arg>BOOL</arg>"
msgstr ""

#. Tag: para
#: configuring.docbook:1760
#, no-c-format
msgid "Set hard word wrapping on or off."
msgstr ""

#. Tag: cmdsynopsis
#: configuring.docbook:1764
