msgstr ""

#. Tag: guilabel
#: configuring.docbook:808 configuring.docbook:1201
#, no-c-format
msgid "Remove trailing spaces"
msgstr ""

#. Tag: para
#: configuring.docbook:809
#, no-c-format
msgid ""
"&kappname; will automatically eliminate extra spaces at the ends of lines of "
"text."
msgstr ""

#. Tag: guilabel
#: configuring.docbook:813
#, no-c-format
msgid "Highlight trailing spaces"
msgstr ""

#. Tag: para
