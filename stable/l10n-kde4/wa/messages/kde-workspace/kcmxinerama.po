#: kcmxinerama.cpp:55
msgid "kcmxinerama"
msgstr "kcmxinerama"

#: kcmxinerama.cpp:56
msgid "KDE Multiple Monitor Configurator"
msgstr "Apontiaedje multi-waitroûle di KDE"

#: kcmxinerama.cpp:58
msgid "(c) 2002-2003 George Staikos"
msgstr "© 2002-2003 George Staikos"

#: kcmxinerama.cpp:60
msgid "George Staikos"
msgstr "George Staikos"

#: kcmxinerama.cpp:63
msgid ""
"<h1>Multiple Monitors</h1> This module allows you to configure KDE support "
"for multiple monitors."
msgstr ""
"<h1>Multi-waitroûle</h1> Ci module ci vos permete d' apontyî l' sopoirt po "
"pus d' ene waitroûle dins KDE."

#: kcmxinerama.cpp:87
#, kde-format
msgid "Display %1"
msgstr "Håynaedje %1"

#: kcmxinerama.cpp:105
msgid "Display Containing the Pointer"
msgstr "Håynaedje contnant l' pwinteu"

#: kcmxinerama.cpp:121
msgid ""
"You do not appear to have a single desktop spread across multiple monitors."
msgstr ""

#: kcmxinerama.cpp:190
msgid "Some settings may affect only newly started applications."
msgstr ""
"Des apontiaedjes k' i gn a pôrént n' aveur nén d' efet so les programes "
"dedja enondés."

#: kcmxinerama.cpp:190
msgid "KDE Multiple Monitors"
msgstr "Multi-waitroûles di KDE"

#: rc.cpp:1
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "Pablo Saratxaga"

#: rc.cpp:2
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr "pablo@walon.org"

#. i18n: file: xineramawidget.ui:17
#. i18n: ectx: property (title), widget (QGroupBox, ButtonGroup1)
#: rc.cpp:5
msgid "Multiple Monitor Support"
msgstr "Sopoirt multi-waitroûles"

#. i18n: file: xineramawidget.ui:23
#. i18n: ectx: property (text), widget (QCheckBox, _enableXinerama)
#: rc.cpp:8
msgid "Enable multiple monitor virtual desktop support"
msgstr ""
"Mete en alaedje li sopoirt des forveyous scribannes so pus d' ene waitroûle"

#. i18n: file: xineramawidget.ui:33
#. i18n: ectx: property (text), widget (QCheckBox, _enableResistance)
#: rc.cpp:11
msgid "Enable multiple monitor window resistance support"
msgstr ""
"Mete en alaedje li sopoirt del rezistance des purneas so pus d' ene waitroûle"

#. i18n: file: xineramawidget.ui:43
#. i18n: ectx: property (text), widget (QCheckBox, _enablePlacement)
#: rc.cpp:14
msgid "Enable multiple monitor window placement support"
msgstr ""
"Mete en alaedje li sopoirt do plaeçmint des purneas so pus d' ene waitroûle"

#. i18n: file: xineramawidget.ui:53
#. i18n: ectx: property (text), widget (QCheckBox, _enableMaximize)
#: rc.cpp:17
msgid "Enable multiple monitor window maximize support"
msgstr ""
"Mete en alaedje li sopoirt des purneas å pus grand so pus d' ene waitroûle"

#. i18n: file: xineramawidget.ui:63
#. i18n: ectx: property (text), widget (QCheckBox, _enableFullscreen)
#: rc.cpp:20
msgid "Enable multiple monitor window fullscreen support"
msgstr "Mete en alaedje li sopoirt do forrimplixhaedje so pus d' ene waitroûle"

#. i18n: file: xineramawidget.ui:92
#. i18n: ectx: property (text), widget (QTableWidget, headTable)
