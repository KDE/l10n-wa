msgstr[0] "Deujhinme cwårt crexhant (li plinne lune c' est dmwin)"
msgstr[1] "Deujhinme cwårt crexhant (li plinne lune c' est dins %1 djoûs)"

#: luna.cpp:274
#, kde-format
msgid "Waning Gibbous (Yesterday was Full Moon)"
msgid_plural "Waning Gibbous (%1 days since Full Moon)"
msgstr[0] "Prumî cwårt discrexhant (li plinne lune c' esteut ayir)"
msgstr[1] "Prumî cwårt discrexhant (li plinne lune c' esteut i gn a %1 djoûs)"

#: luna.cpp:279
msgid "Last Quarter"
msgstr "Dierin cwårtî"

#: luna.cpp:291
#, kde-format
msgid "Waning Crescent (Tomorrow is New Moon)"
