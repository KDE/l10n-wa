#: pastebin.cpp:216
msgctxt "The status of the applet has not been set - i.e. it is unset."
msgid "Unset"
msgstr "Nén defini"

#: pastebin.cpp:221
msgid "Drop text or an image onto me to upload it to Pastebin."
msgstr ""
"Bodjîz on scrijhaedje ou ene imådje eyet poizer e mi po l' eberweter dins "
"Pastebin."

#: pastebin.cpp:226
msgid "Error during upload. Try again."
msgstr "Åk n' a nén stî come dj' eberweteu. Sayîz co on côp."

#: pastebin.cpp:234, kde-format
#| msgid ""
#| "Successfully posted to: <a href=\"%1\">%2</a><p>Drag text/image here to "
#| "post to server"
msgid "Successfully uploaded to %1."
msgstr "L' eberwetaedje so %1 a stî comifåt."

#: pastebin.cpp:242
msgid "Sending...."
msgstr "Evoyaedje..."

#: pastebin.cpp:370
msgid "Drop!"
msgstr "Poizer!"

#: pastebin.cpp:389
msgid "Error: Try Again"
msgstr "Aroke : Sayîz co on côp"

#: pastebin.cpp:447
msgid "General"
msgstr "Djenerå"

#: pastebin.cpp:455
msgid "Servers"
msgstr "Sierveus"

#: pastebin.cpp:516
#, kde-format
msgctxt ""
"Notification when the pastebin applet has copied the URL to the clipboard"
msgid "%1 has been copied to your clipboard"
msgstr "%1 a stî copyî e vosse tchapea emacralé"

#: pastebin.cpp:518
msgid "Open browser"
msgstr "Drovi betchteu"

