#. i18n: file: general.ui:39
#. i18n: ectx: property (whatsThis), widget (KComboBox, sortType)
#: rc.cpp:43
msgid ""
"Change the current sorting method.\n"
"\n"
"Priority:\n"
"Items are first sorted by their priority (1, 2, 3, none) and secondly by due "
"date.\n"
"\n"
"Due Date:\n"
"Items are first sorted by their due date and secondly by priority."
msgstr ""
"Candjî l' metôde di relijhaedje.\n"
"\n"
"Prumiristé:\n"
"Les cayets sont-st aprume reliîs sorlon leu prumiristé (1, 2, 3, nole) ey "
"adon pa date di termene.\n"
"\n"
"Date di termene:\n"
"Les cayets sont-st aprume relîs pa leu date di termene ey adon pa prumiristé."

