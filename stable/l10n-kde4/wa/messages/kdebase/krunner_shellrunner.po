#. i18n: tag string
#. i18n: file shellOptions.ui line 90
#: rc.cpp:3
msgid ""
"<qt>Select whether realtime scheduling should be enabled for the "
"application. The scheduler governs which process will run and which will "
"have to wait. Two schedulers are available:\n"
"<ul>\n"
"<li><em>Normal:</em> This is the standard, timesharing scheduler. It will "
"divide fairly the available processing time between all processes.</li>\n"
"<li><em>Realtime:</em>This scheduler will run your application uninterrupted "
"until it gives up the processor. This can be dangerous. An application that "
"does not give up the processor might hang the system. You need root's "
"password to use the scheduler.</li>\n"
"</ul>\n"
"</qt>"
msgstr ""

#. i18n: tag string
#. i18n: file shellOptions.ui line 93
#: rc.cpp:11
msgid "Run with realtime &scheduling"
msgstr "Enonder avou &programaedje e vraiy tins"

#. i18n: tag string
#. i18n: file shellOptions.ui line 111
#. i18n: tag string
#. i18n: file shellOptions.ui line 242
#: rc.cpp:14 rc.cpp:47
msgid "Enter the user you want to run the application as here."
msgstr "Sititchîz l' uzeu k' vos vloz ki l' enonde ci programe."

#. i18n: tag string
#. i18n: file shellOptions.ui line 114
#: rc.cpp:17
msgid "User&name:"
msgstr "&No d' uzeu:"

#. i18n: tag string
#. i18n: file shellOptions.ui line 135
#. i18n: tag string
#. i18n: file shellOptions.ui line 156
#: rc.cpp:20 rc.cpp:23
msgid "Enter the password here for the user you specified above."
msgstr "Sititchîz chal li scret po l' uzeu k' vos avoz specifyî pa dzeu."

#. i18n: tag string
#. i18n: file shellOptions.ui line 159
#: rc.cpp:26
msgid "Pass&word:"
msgstr "Sicre&t:"

#. i18n: tag string
#. i18n: file shellOptions.ui line 169
#: rc.cpp:29
msgid ""
"Check this option if the application you want to run is a text mode "
"application. The application will then be run in a terminal emulator window."
msgstr ""

#. i18n: tag string
#. i18n: file shellOptions.ui line 172
#: rc.cpp:32
msgid "Run in &terminal window"
msgstr "Enonder dins on purnea &terminå"

#. i18n: tag string
#. i18n: file shellOptions.ui line 190
#. i18n: tag string
#. i18n: file shellOptions.ui line 260
#. i18n: tag string
#. i18n: file shellOptions.ui line 273
#. i18n: tag string
#. i18n: file shellOptions.ui line 297
#: rc.cpp:35 rc.cpp:50 rc.cpp:56 rc.cpp:62
msgid ""
"The priority that the command will be run with can be set here. From left to "
"right, it goes from low to high. The center position is the default value. "
"For priorities higher than the default, you will need to provide the root "
"password."
msgstr ""

#. i18n: tag string
#. i18n: file shellOptions.ui line 193
#: rc.cpp:38
msgid "&Priority:"
msgstr "&Prumiristé:"

#. i18n: tag string
#. i18n: file shellOptions.ui line 221
#: rc.cpp:41
msgid ""
"Check this option if you want to run the application with a different "
"priority. A higher priority tells the operating system to give more "
"processing time to your application."
msgstr ""

#. i18n: tag string
#. i18n: file shellOptions.ui line 224
#: rc.cpp:44
msgid "Run with a &different priority"
msgstr "Enonder avou ene ôt&e prumiristé"

#. i18n: tag string
#. i18n: file shellOptions.ui line 263
#: rc.cpp:53
msgid "Low"
msgstr "Basse"

#. i18n: tag string
#. i18n: file shellOptions.ui line 276
#: rc.cpp:59
msgid "High"
msgstr "Hôte"

#. i18n: tag string
#. i18n: file shellOptions.ui line 312
#: rc.cpp:65
msgid ""
"Check this option if you want to run the application with a different user "
"id. Every process has a user id associated with it. This id code determines "
"file access and other permissions. The password of the user is required to "
"do this."
msgstr ""

#. i18n: tag string
#. i18n: file shellOptions.ui line 315
#: rc.cpp:68
msgid "Run as a different &user"
msgstr "Enonder come en ôte &uzeu"

