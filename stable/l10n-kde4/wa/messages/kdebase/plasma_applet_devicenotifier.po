#: deviceitem.cpp:271
msgid "Click to safely remove this device from the computer."
msgstr "Clictchî po oister al coete cist éndjin del copiutrece"

#: deviceitem.cpp:272
msgid "Device is plugged in and can be accessed by applications."
msgstr "L' éndjin est tchôkî eyet les programes î savèt moussî."

#: deviceitem.cpp:274
msgid "Click to access this device from other applications."
msgstr "Clitchîz po k' d' ôtes programes moussexhe dins cist éndjin."

#: deviceitem.cpp:275
msgid "Device is plugged in, but not mounted for access yet."
msgstr "L' éndjin est tchôkî mins n' est nén co monté pos î moussî."

#: deviceitem.cpp:366
#, kde-format
msgctxt "@info:status Free disk space"
msgid "%1 free"
msgstr "%1 libe"

#: devicenotifier.cpp:197
#, kde-format
msgid "1 action for this device"
msgid_plural "%1 actions for this device"
msgstr[0] "1 accion po cist éndjin"
msgstr[1] "%1 accions po cist éndjin"

#: devicenotifier.cpp:266
msgid "No devices plugged in"
msgstr "Nol éndjin tchôkî"

#: devicenotifier.cpp:270
#, kde-format
msgid "Last plugged in device: %1"
msgstr "Dierin éndjin tchôkî: %1"

#: devicenotifier.cpp:372
msgctxt "General options page"
msgid "General"
msgstr "Djenerå"

#: notifierdialog.cpp:65
msgid "Show hidden devices"
msgstr "Mostrer les éndjins catchîs"

#: notifierdialog.cpp:513
msgid ""
"Could not unmount the device.\n"
"One or more files on this device are open within an application."
msgstr ""
"Dji n' savou dismonter l' éndjin.\n"
"On fitchî ou pus so cist éndjin sont drovous dins on programe."

#: notifierdialog.cpp:532
msgid ""
"Cannot eject the disc.\n"
"One or more files on this disc are open within an application."
msgstr ""
"Dji n' sai fé rexhe li plake.\n"
"On fitchî ou pus so cisse plake sont drovous dins ene aplicåcion."

#: notifierdialog.cpp:547
msgid "Cannot mount the disc."
msgstr "Dji n' sai monter l' plake."

#: notifierdialog.cpp:756
#, kde-format
msgctxt "Hide a device"
msgid "Hide %1"
msgstr "Catchî %1"

#: notifierdialog.cpp:820
msgid "No devices plugged in."
msgstr "Nol éndjin tchôkî."

#: notifierdialog.cpp:822
msgid "Devices recently plugged in:"
msgstr "Éndjins tchôkîs enawaire :"

