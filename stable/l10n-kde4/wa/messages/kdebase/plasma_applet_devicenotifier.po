#: deviceitem.cpp:292
msgid "Click to eject this disc."
msgstr "Clitchîz po fé rexhe cisse plake cial."

#: deviceitem.cpp:295
#| msgid "Click to safely remove this device from the computer."
msgid "Click to safely remove this device."
msgstr "Clictchîz po oister al coete cist éndjin cial."

#: deviceitem.cpp:297
#| msgid "Click to safely remove this device from the computer."
msgid "Click to unmount this device."
msgstr "Clitchîz po dismonter cist éndjin cial."

#: deviceitem.cpp:301
msgid ""
"It is currently <b>not safe</b> to remove this device: applications may be "
"accessing it. Click the eject button to safely remove this device."
msgstr ""
"Vos <b>n' poloz nén</b> oister cist éndjin la al coete : des programes l' "
"eployèt motoit. Clitchîz sol boton po fé rexhe po oister cist éndjin la al "
"coete."

#: deviceitem.cpp:303
msgid "This device is currently accessible."
msgstr "Cist éndjin cial est arinnåve pol moumint."

#: deviceitem.cpp:306
msgid "Click to access this device from other applications."
msgstr "Clitchîz po k' d' ôtes programes moussexhe dins cist éndjin la."

#: deviceitem.cpp:309
msgid "It is currently safe to remove this device."
msgstr "Vos ploz asteure oister cist éndjin cial al coete."

#: deviceitem.cpp:311
msgid ""
"It is currently <b>not safe</b> to remove this device: applications may be "
"accessing other volumes on this device. Click the eject button on these "
"other volumes to safely remove this device."
msgstr ""
"Vos <b>n' poloz nén</b> oister cist éndjin la al coete : des programes "
"eployèt motoit d' ôtes volumes so cist éndjin la. Clitchîz sol boton po fé "
"rexhe po oister cist éndjin la al coete."

#: deviceitem.cpp:314
msgid "This device is currently not accessible."
msgstr "Cist éndjin cial n' est nén arinnåve pol moumint."

#: deviceitem.cpp:407
#, kde-format
msgctxt "@info:status Free disk space"
msgid "%1 free"
msgstr "%1 libe"

#: deviceitem.cpp:461
msgctxt ""
"Accessing is a less technical word for Mounting; translation should be short "
"and mean 'Currently mounting this device'"
msgid "Accessing..."
msgstr "Dj' î mousse..."

#: deviceitem.cpp:464
#| msgid "Unmounting..."
msgctxt ""
"Removing is a less technical word for Unmounting; translation shoud be short "
"and mean 'Currently unmounting this device'"
msgid "Removing..."
msgstr "Dji oistêye..."

#: devicenotifier.cpp:102
#, kde-format
msgid "1 action for this device"
msgid_plural "%1 actions for this device"
msgstr[0] "1 accion po cist éndjin cial"
msgstr[1] "%1 accions po cist éndjin cial"

#: devicenotifier.cpp:334
msgid "No devices available."
msgstr "I gn a pont d' éndjin."

#: devicenotifier.cpp:338
#| msgid "Most recent device: %1"
msgid "Most recent device"
msgstr "Li tot dierin éndjin"

#: devicenotifier.cpp:468
msgid "Display"
msgstr "Håynaedje"

#: devicenotifier.cpp:471
msgid "Automounting"
msgstr "Otomontaedje"

#: notifierdialog.cpp:69
msgid "Show hidden devices"
msgstr "Mostrer les éndjins catchîs"

#: notifierdialog.cpp:973
#, kde-format
msgctxt "Hide a device"
msgid "Hide %1"
msgstr "Catchî %1"

#: notifierdialog.cpp:1037
msgid "Available Devices"
msgstr "Éndjins k' i gn a "

#: notifierdialog.cpp:1039
msgid "No Devices Available"
msgstr "I gn a pont d' éndjin"

