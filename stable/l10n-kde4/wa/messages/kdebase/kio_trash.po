#: kcmtrash.cpp:120
msgid "Byte"
msgstr "Octet"

#: kcmtrash.cpp:122
msgid "KByte"
msgstr "KOctet"

#: kcmtrash.cpp:126
msgid "MByte"
msgstr "MOctet"

#: kcmtrash.cpp:130
msgid "GByte"
msgstr "GOctet"

#: kcmtrash.cpp:134
msgid "TByte"
msgstr "TOctet"

#: kcmtrash.cpp:139
#, kde-format
msgctxt ""
"%1 is amount of disk space, %2 the unit, KBytes, MBytes, GBytes, TBytes, etc."
msgid "(%1 %2)"
msgstr "(%1 %2)"

#: kcmtrash.cpp:178 kcmtrash.cpp:278
msgid " day"
msgid_plural " days"
msgstr[0] " djoû"
msgstr[1] " djoûs"

#: kcmtrash.cpp:269
msgid "Delete files older than:"
msgstr "Disfacer les fitchîs pus vîs k' :"

#: kcmtrash.cpp:271
msgctxt "@info:whatsthis"
msgid ""
"<para>Check this box to allow <b>automatic deletion</b> of files that are "
"older than the value specified. Leave this disabled to <b>not</b> "
"automatically delete any items after a certain timespan</para>"
msgstr ""

#: kcmtrash.cpp:280
msgctxt "@info:whatsthis"
msgid ""
"<para>Set the number of days that files can remain in the trash. Any files "
"older than this will be automatically deleted.</para>"
msgstr ""

#: kcmtrash.cpp:287
msgid "Limit to maximum size"
msgstr "Limiter al grandeu macsimom"

#: kcmtrash.cpp:289
msgctxt "@info:whatsthis"
msgid ""
"<para>Check this box to limit the trash to the maximum amount of disk space "
"that you specify below. Otherwise, it will be unlimited.</para>"
msgstr ""

#: kcmtrash.cpp:300
msgid "Maximum size:"
msgstr "Grandeu macsimom :"

#: kcmtrash.cpp:309
msgctxt "@info:whatsthis"
msgid ""
"<para>This is the maximum percent of disk space that will be used for the "
"trash.</para>"
msgstr ""

#: kcmtrash.cpp:314
msgctxt "@info:whatsthis"
msgid ""
"<para>This is the calculated amount of disk space that will be allowed for "
"the trash, the maximum.</para>"
msgstr ""

#: kcmtrash.cpp:317
msgid "When limit reached:"
msgstr "Cwand l' limite a-st arivé :"

#: kcmtrash.cpp:321
msgid "Warn Me"
msgstr "M' advierti"

#: kcmtrash.cpp:322
msgid "Delete Oldest Files From Trash"
msgstr "Disfacer les pus vîs fitchîs do batch"

#: kcmtrash.cpp:323
msgid "Delete Biggest Files From Trash"
msgstr "Disfacer les pus gros fitchîs do batch"

#: kcmtrash.cpp:325
msgctxt "@info:whatsthis"
msgid ""
"<para>When the size limit is reached, it will prefer to delete the type of "
"files that you specify, first. If this is set to warn you, it will do so "
"instead of automatically deleting files.</para>"
msgstr ""

#: kio_trash.cpp:92 kio_trash.cpp:155 kio_trash.cpp:307 kio_trash.cpp:339
#: kio_trash.cpp:505 kio_trash.cpp:517
#, kde-format
msgid "Malformed URL %1"
msgstr "Hårdêye (URL) må fwaite %1."

#: kio_trash.cpp:111
#, kde-format
msgid ""
"The directory %1 does not exist anymore, so it is not possible to restore "
"this item to its original location. You can either recreate that directory "
"and use the restore operation again, or drag the item anywhere else to "
"restore it."
msgstr ""
"Li ridant %1 n' egzistêye pus, ça fwait ki ç' n' est pus possibe di rapexhî "
"ci cayet ci viè si plaece di dvant. Vos ploz soeye-t i rifé l' ridant et "
"rinonder l' rapexhaedje, oudonbén saetchî l' cayet a ene ôte plaece pol "
"rapexhî."

#: kio_trash.cpp:140 kio_trash_win.cpp:228
msgid "This file is already in the trash bin."
msgstr "Ci fitchî la est ddja å batch."

#: kio_trash.cpp:228 kio_trash_win.cpp:252
msgid "Internal error in copyOrMove, should never happen"
msgstr "Divintrinne aroke dins copyOrMove, ni dvreut djamais s' passer"

#: kio_trash_win.cpp:241
msgid "not supported"
msgstr "nén sopoirté"

#: ktrash.cpp:32
msgid "ktrash"
msgstr "kbatch"

#: ktrash.cpp:34
msgid ""
"Helper program to handle the KDE trash can\n"
"Note: to move files to the trash, do not use ktrash, but \"kioclient move "
"'url' trash:/\""
msgstr ""
"Programe aideu po manaedjî l' batch å mannestés di KDE\n"
"Note: po taper des fitchîs å batch, n' eployîs nén «ktrash» mins «kioclient "
"move 'eplaeçmint' trash:/» (avou «eplaeçmint» li tchmin avou l' no do fitchî "
"a taper å batch)."

#: ktrash.cpp:38
msgid "Empty the contents of the trash"
msgstr "Vudî l' batch di çou k' i gn a dvins"

#: ktrash.cpp:40
msgid "Restore a trashed file to its original location"
msgstr "Rapexhî on fitchî evoyî å batch et l' mete a s' plaece di dvant"

#: ktrash.cpp:42
msgid "Ignored"
msgstr "Passé houte"

#: trashimpl.cpp:1125
msgid ""
"The trash has reached its maximum size!\n"
"Cleanup the trash manually."
msgstr ""
"Li batch est asteure a s' grandeu macsimom !\n"
"Netyîz l' batch al mwin."

#: trashimpl.cpp:1136
msgid "The file is too large to be trashed."
msgstr "Ci fitchî la est trop gros pos esse tapé å batch."

