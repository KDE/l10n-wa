#: devicewrapper.cpp:143 devicewrapper.cpp:159
msgid "Eject medium"
msgstr "Fé rexhe li media"

#: devicewrapper.cpp:147
msgid "Mount the device"
msgstr "Monter l' éndjin"

#: devicewrapper.cpp:149
msgid "Unmount the device"
msgstr "Dismonter l' éndjin"

#: devicewrapper.cpp:153
msgctxt ""
"Unlock the encrypted container; will ask for a password; partitions inside "
"will appear as they had been plugged in"
msgid "Unlock the container"
msgstr "Dizeclawer l' contneu"

#: devicewrapper.cpp:155
msgctxt ""
"Close the encrypted container; partitions inside will disappear as they had "
"been unplugged"
msgid "Lock the container"
msgstr "Eclawer l' contneu"

#: solidrunner.cpp:48
msgid "Finds devices whose name match :q:"
msgstr "Trove des éndjins k' ont leu no ki corespondèt a :q:"

#: solidrunner.cpp:50 solidrunner.cpp:139
msgctxt "Note this is a KRunner keyword"
msgid "device"
msgstr "éndjin"

#: solidrunner.cpp:51
msgid "Lists all devices and allows them to be mounted, unmounted or ejected."
msgstr ""
"Fwait l' djivêye di tos les éndjins eyet lzi permete d' esse montés, "
"dismontés ou rexhous."

#: solidrunner.cpp:52 solidrunner.cpp:145
msgctxt "Note this is a KRunner keyword"
msgid "mount"
msgstr "monter"

#: solidrunner.cpp:53
msgid "Lists all devices which can be mounted, and allows them to be mounted."
msgstr ""
"Fwait l' djivêye di tos les éndjins k' ont sait monter eyet lzi permete d' "
"esse montés."

#: solidrunner.cpp:54 solidrunner.cpp:158
msgctxt "Note this is a KRunner keyword"
msgid "unlock"
msgstr "dizeclawer"

#: solidrunner.cpp:55
msgid ""
"Lists all encrypted devices which can be unlocked, and allows them to be "
"unlocked."
msgstr ""
"Fwait l' djivêye di tos les éndjins ecriptés k' ont sait dizeclawer eyet lzi "
"permete d' esse dizeclawés."

#: solidrunner.cpp:56 solidrunner.cpp:149
msgctxt "Note this is a KRunner keyword"
msgid "unmount"
msgstr "dismonter"

#: solidrunner.cpp:57
msgid ""
"Lists all devices which can be unmounted, and allows them to be unmounted."
msgstr ""
"Fwait l' djivêye di tos les éndjins k' ont sait dismonter eyet lzi permete "
"d' esse dismontés."

#: solidrunner.cpp:58 solidrunner.cpp:163
msgctxt "Note this is a KRunner keyword"
msgid "lock"
msgstr "eclawer"

#: solidrunner.cpp:59
msgid ""
"Lists all encrypted devices which can be locked, and allows them to be "
"locked."
msgstr ""
"Fwait l' djivêye di tos les éndjins eclawés k' ont sait eclawer eyet lzi "
"permete d' esse eclawés."

#: solidrunner.cpp:61 solidrunner.cpp:153
msgctxt "Note this is a KRunner keyword"
msgid "eject"
msgstr "fé rexhe"

#: solidrunner.cpp:62
msgid "Lists all devices which can be ejected, and allows them to be ejected."
msgstr ""
"Fwait l' djivêye di tos les éndjins k' ont sait fé rexhe eyet lzi permete d' "
"esse rehous."

#~ msgid ""
#~ "Could not unmount the device.\n"
#~ "One or more files on this device are open within an application."
#~ msgstr ""
#~ "Dji n' savou dismonter l' éndjin.\n"
#~ "On fitchî ou pus so cist éndjin sont drovous dins on programe."

#~ msgid ""
#~ "Could not eject the disc.\n"
#~ "One or more files on this disc are open within an application."
#~ msgstr ""
#~ "Dji n' a savou fé rexhe li plake.\n"
#~ "On fitchî ou pus so cisse plake sont drovous dins ene aplicåcion."
