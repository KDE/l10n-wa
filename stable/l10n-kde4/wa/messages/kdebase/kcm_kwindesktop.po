#: desktop.cpp:66
msgid ""
"<h1>Multiple Desktops</h1>In this module, you can configure how many virtual "
"desktops you want and how these should be labeled."
msgstr ""
"<h1>Sacwants scribannes</h1>Divins c' module vos ploz apontyî cobén d' "
"forveyous scribannes vos vloz eyet comint i dvrént esse lomés."

#: desktop.cpp:78
msgid "N&umber of desktops: "
msgstr "N&ombe di scribannes:"

#: desktop.cpp:84
msgid ""
"Here you can set how many virtual desktops you want on your KDE desktop. "
"Move the slider to change the value."
msgstr ""
"Vos ploz chal defini cobén d' forveyous scribannes vos vloz so vosse "
"sicribanne KDE. Bodjîz l' boton d' acinseu po candjî l' valixhance."

#: desktop.cpp:97
msgid "Desktop &Names"
msgstr "&Nos des scribannes"

#: desktop.cpp:102
#, kde-format
msgid "Desktop %1:"
msgstr "Sicribanne %1:"

#: desktop.cpp:105 desktop.cpp:106
#, kde-format
msgid "Here you can enter the name for desktop %1"
msgstr "Vos ploz chal intrer l' no do scribanne %1"

#: desktop.cpp:120
msgid "Mouse wheel over desktop background switches desktop"
msgstr "Li rôlete del sori sol fond do scribanne fwait candjî d' sicribanne"

#: desktop.cpp:247 desktop.cpp:271
#, kde-format
msgid "Desktop %1"
msgstr "Sicribanne %1"
