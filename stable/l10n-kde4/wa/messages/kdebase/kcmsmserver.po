#: kcmsmserver.cpp:52
msgid ""
"<h1>Session Manager</h1> You can configure the session manager here. This "
"includes options such as whether or not the session exit (logout) should be "
"confirmed, whether the session should be restored again when logging in and "
"whether the computer should be automatically shut down after session exit by "
"default."
msgstr ""

#. i18n: file: smserverconfigdlg.ui:13
#. i18n: ectx: property (windowTitle), widget (QWidget, SMServerConfigDlg)
#: rc.cpp:3 rc.cpp:58
msgid "Session Manager"
msgstr "Manaedjeu des sessions"

#. i18n: file: smserverconfigdlg.ui:36
#. i18n: ectx: property (title), widget (QGroupBox, topBox)
#: rc.cpp:6 rc.cpp:61
msgid "General"
msgstr "Djenerå"

#. i18n: file: smserverconfigdlg.ui:44
#. i18n: ectx: property (whatsThis), widget (QCheckBox, confirmLogoutCheck)
#: rc.cpp:9 rc.cpp:64
msgid ""
"Check this option if you want the session manager to display a logout "
"confirmation dialog box."
msgstr ""

#. i18n: file: smserverconfigdlg.ui:47
#. i18n: ectx: property (text), widget (QCheckBox, confirmLogoutCheck)
#: rc.cpp:12 rc.cpp:67
msgid "Conf&irm logout"
msgstr "Acert&iner dislodjaedje"

#. i18n: file: smserverconfigdlg.ui:54
#. i18n: ectx: property (text), widget (QCheckBox, offerShutdownCheck)
#: rc.cpp:15 rc.cpp:70
msgid "O&ffer shutdown options"
msgstr "O&fri des tchuzes å distindaedje"

#. i18n: file: smserverconfigdlg.ui:79
#. i18n: ectx: property (whatsThis), widget (QGroupBox, sdGroup)
#: rc.cpp:18 rc.cpp:73
msgid ""
"Here you can choose what should happen by default when you log out. This "
"only has meaning, if you logged in through KDM."
msgstr ""

#. i18n: file: smserverconfigdlg.ui:82
#. i18n: ectx: property (title), widget (QGroupBox, sdGroup)
#: rc.cpp:21 rc.cpp:76
msgid "Default Leave Option"
msgstr "Prémetowès tchuzes po moussî foû"

#. i18n: file: smserverconfigdlg.ui:88
#. i18n: ectx: property (text), widget (QRadioButton, logoutRadio)
#: rc.cpp:24 rc.cpp:79
msgid "&End current session"
msgstr "&Fini l' session do moumint"

#. i18n: file: smserverconfigdlg.ui:95
#. i18n: ectx: property (text), widget (QRadioButton, haltRadio)
#: rc.cpp:27 rc.cpp:82
msgid "&Turn off computer"
msgstr "&Distinde li copiutrece"

#. i18n: file: smserverconfigdlg.ui:102
#. i18n: ectx: property (text), widget (QRadioButton, rebootRadio)
#: rc.cpp:30 rc.cpp:85
msgid "&Restart computer"
msgstr "&Renonder l' copiutrece"

#. i18n: file: smserverconfigdlg.ui:120
#. i18n: ectx: property (whatsThis), widget (QGroupBox, loginGroup)
#: rc.cpp:33 rc.cpp:88
msgid ""
"<ul>\n"
"<li><b>Restore previous session:</b> Will save all applications running on "
"exit and restore them when they next start up</li>\n"
"<li><b>Restore manually saved session: </b> Allows the session to be saved "
"at any time via \"Save Session\" in the K-Menu. This means the currently "
"started applications will reappear when they next start up.</li>\n"
"<li><b>Start with an empty session:</b> Do not save anything. Will come up "
"with an empty desktop on next start.</li>\n"
"</ul>"
msgstr ""

#. i18n: file: smserverconfigdlg.ui:123
#. i18n: ectx: property (title), widget (QGroupBox, loginGroup)
#: rc.cpp:40 rc.cpp:95
msgid "On Login"
msgstr "A l' elodjaedje"

#. i18n: file: smserverconfigdlg.ui:131
#. i18n: ectx: property (text), widget (QRadioButton, previousSessionRadio)
#: rc.cpp:43 rc.cpp:98
msgid "Restore &previous session"
msgstr "Rassonrer session &di dvant"

#. i18n: file: smserverconfigdlg.ui:138
#. i18n: ectx: property (text), widget (QRadioButton, savedSessionRadio)
#: rc.cpp:46 rc.cpp:101
msgid "Restore &manually saved session"
msgstr "Rassonrer session schapêye al &mwin"

#. i18n: file: smserverconfigdlg.ui:145
#. i18n: ectx: property (text), widget (QRadioButton, emptySessionRadio)
#: rc.cpp:49 rc.cpp:104
msgid "Start with an empty &session"
msgstr "Enonder avou ene vude &session"

#. i18n: file: smserverconfigdlg.ui:152
#. i18n: ectx: property (text), widget (QLabel, textLabel1)
#: rc.cpp:52 rc.cpp:107
msgid "Applications to be e&xcluded from sessions:"
msgstr "Programes a n' &nén prinde dins les sessions:"

#. i18n: file: smserverconfigdlg.ui:165
#. i18n: ectx: property (whatsThis), widget (KLineEdit, excludeLineedit)
#: rc.cpp:55 rc.cpp:110
msgid ""
"Here you can enter a colon or comma separated list of applications that "
"should not be saved in sessions, and therefore will not be started when "
"restoring a session. For example 'xterm:konsole' or 'xterm,konsole'."
msgstr ""

