#: khtmlkttsd.cpp:43
msgid "&Speak Text"
msgstr "&Cåzer li tecse"

#: khtmlkttsd.cpp:60
msgid "Cannot Read source"
msgstr "Dji n' sai nén lére li sourdant"

#: khtmlkttsd.cpp:61
msgid ""
"You cannot read anything except web pages with\n"
"this plugin, sorry."
msgstr ""
"Vos n' poloz rén lére d' ôte ki les pådjes waibes avou\n"
"ci tchôke-divins, mande escuze."

