#: fonts.cpp:219
msgid "Configure Anti-Alias Settings"
msgstr "Apontyî les tchuzes di lissaedje"

#: fonts.cpp:225
msgid "E&xclude range:"
msgstr "Foute e&voye li djive:"

#: fonts.cpp:228 fonts.cpp:233
