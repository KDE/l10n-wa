#: dockbarextension.cpp:327
#, c-format
msgid "The following dockbar applets could not be started: %1"
msgstr "Les apliketes shuvante del bår di dock n' a nén plou esse enondêye: %1"

#: dockbarextension.cpp:327
msgid "kicker: information"
msgstr "kicker: informåcion"

#: dockcontainer.cpp:150
msgid "Enter Command Line for Applet %1.%2"
msgstr "Intrez l' roye di cmande po l' aplikete %1. %2"

#: dockcontainer.cpp:151
msgid ""
"This applet does not behave correctly and the dockbar was unable to find the "
"command line necessary to launch it the next time KDE starts up"
msgstr "Cisse aplikete ni rote nén comifåt eyet l' bår di dock n' a nén sepou trover l' roye di cmande k' i fåt pol lancî e l' enondaedje shuvant di KDE"

#: dockcontainer.cpp:174
msgid "Kill This Applet"
msgstr "Touwer ciste aplikete"

#: dockcontainer.cpp:175
msgid "Change Command"
msgstr "Candjî l' comande"

