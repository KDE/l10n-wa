#: medianotifier.cpp:173
#, qt-format
msgid ""
"An autorun file as been found on your '%1'. Do you want to execute it?\n"
"Note that executing a file on a medium may compromise your system's security"
msgstr ""
"On fitchî enonde-tot-seu a stî trové so vosse «%1». El voloz enonder?\n"
"Atincion, enonder on fitchî a pårti d' on mediom pout fé må al såvrité di vosse sistinme."

#: medianotifier.cpp:177
#, qt-format
msgid "Autorun - %1"
msgstr "Enonde-tot-seu - %1"

#: medianotifier.cpp:246
#, qt-format
msgid ""
"An autoopen file as been found on your '%1'. Do you want to open '%2'?\n"
"Note that opening a file on a medium may compromise your system's security"
msgstr ""
"On fitchî drove-tot-seu a stî trové so vosse «%1». Voloz drovi «%2»?\n"
"Atincion, drovi on fitchî a pårti d' on mediom pout fé må al såvrité di vosse sistinme."

#: medianotifier.cpp:250
#, qt-format
msgid "Autoopen - %1"
msgstr "Drove-tot-seu - %1"

#: notificationdialog.cpp:58
