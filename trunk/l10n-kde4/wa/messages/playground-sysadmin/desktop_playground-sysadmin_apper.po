#: Desktop/apperd.desktop:8
msgctxt "Name"
msgid "Apper Monitor"
msgstr "Corwaitoe d' Apper"

#: Desktop/apperd.desktop:19
msgctxt "Comment"
msgid "Watch transactions and Notify about Software Updates"
msgstr ""
"Waitî après les tranzaccions eyet notifyî cwand gn a des metaedjes a djoû "
"des programes"

#: Desktop/apper.desktop:9 Sentinel/ApperSentinel.notifyrc:3
msgctxt "Name"
msgid "Apper"
msgstr "Apper"

#: Desktop/apper.desktop:28
msgctxt "GenericName"
msgid "Software Management"
msgstr "Manaedjmint des programes"

#: Desktop/apper.desktop:61
msgctxt "Comment"
msgid "Application to get and manage software"
msgstr "Programe po cweri eyet manaedjî ses programes"

#: Desktop/kcm_apper.desktop:14
msgctxt "Name"
msgid "Software Management"
msgstr "Manaedjmint des programes"

#: Desktop/kcm_apper.desktop:48
msgctxt "Comment"
msgid "Get, Remove and Update Software"
msgstr "Cweri, oister eyet mete a djoû des programes"

#: Sentinel/ApperSentinel.notifyrc:22
msgctxt "Comment"
msgid "Apper Notification"
msgstr "Notifiaedje d' Apper"

#: Sentinel/ApperSentinel.notifyrc:34
msgctxt "Name"
msgid "New updates available"
msgstr "I gn des noveas metaedjes a djoû"

#: Sentinel/ApperSentinel.notifyrc:52
msgctxt "Name"
msgid "Updates are being installed"
msgstr "Des metaedjes a djoû sont-st a l' astalaedje"

#: Sentinel/ApperSentinel.notifyrc:89
msgctxt "Name"
msgid "A System Restart is Required"
msgstr "I fåt renonder l' sistinme"

#: Sentinel/ApperSentinel.notifyrc:125
msgctxt "Name"
msgid "A transaction failed to complete successfully"
msgstr "Ene tranzaccion n' s' a nén savou fini comifåt"

#: Sentinel/ApperSentinel.notifyrc:159
msgctxt "Name"
msgid "Updates finished installing"
msgstr "Les metaedjes a djoû ont fini d' s' astaler"

#: Sentinel/ApperSentinel.notifyrc:194
msgctxt "Name"
msgid "A transaction error occurred"
msgstr "Åk n' a nén stî avou l' tranzaccion"

#: Sentinel/ApperSentinel.notifyrc:226
msgctxt "Name"
msgid "A distribution upgrade is available"
msgstr "I gn a on metaedje a livea del distribucion"

#: Sentinel/ApperSentinel.notifyrc:260
msgctxt "Name"
msgid "The distribution upgrade completed"
msgstr "Li metaedje a livea del distribucion est tot fwait"

#: Sentinel/ApperSentinel.notifyrc:294
msgctxt "Name"
msgid "The distribution upgrade completed with an error"
msgstr "Li metaedje a livea del distribucion s' a fini avou ene aroke"
