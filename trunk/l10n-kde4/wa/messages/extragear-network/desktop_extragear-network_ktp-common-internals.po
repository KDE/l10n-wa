#: data/ktelepathy.notifyrc:3
msgctxt "Name"
msgid "Instant messaging"
msgstr "Messaedjreye sol moumint"

#: data/ktelepathy.notifyrc:40
msgctxt "Comment"
msgid "Instant messaging"
msgstr "Messaedjreye sol moumint"

#: data/ktelepathy.notifyrc:79
msgctxt "Name"
msgid "Group"
msgstr "Groupe"

#: data/ktelepathy.notifyrc:117
msgctxt "Comment"
msgid "The group where the contact resides"
msgstr "Li groupe k' el soçon est dvins"

#: data/ktelepathy.notifyrc:157
msgctxt "Name"
msgid "Contact"
msgstr "Soçon"

#: data/ktelepathy.notifyrc:195
msgctxt "Comment"
msgid "The specified contact"
msgstr "Li soçon specifyî"

#: data/ktelepathy.notifyrc:235
msgctxt "Name"
msgid "Class"
msgstr "Classe"

#: data/ktelepathy.notifyrc:273
msgctxt "Comment"
msgid "The message class"
msgstr "Li classe do messaedje"

#: data/ktelepathy.notifyrc:316
msgctxt "Name"
msgid "Instant messaging error"
msgstr "Aroke del messaedjreye sol moumint"

#: data/ktelepathy.notifyrc:353
msgctxt "Comment"
msgid "An error occurred within instant messaging"
msgstr "Åk n' a nén stî dins ene messaedjreye sol moumint"

#: data/ktelepathy.notifyrc:395
msgctxt "Name"
msgid "Instant messaging info message"
msgstr "Messaedje d' informåcion sol messaedjreye sol moumint"

#: data/ktelepathy.notifyrc:432
msgctxt "Comment"
msgid "A general info message from instant messaging"
msgstr "On messaedje djenerå d' informåcion del messaedjreye sol moumint"

#: data/ktelepathy.notifyrc:476
msgctxt "Name"
msgid "Incoming Message"
msgstr "Messaedje intrant"

#: data/ktelepathy.notifyrc:514
msgctxt "Comment"
msgid "An incoming message has been received"
msgstr "On messaedje intrant a stî rçî"

#: data/ktelepathy.notifyrc:559
msgctxt "Name"
msgid "Incoming Message in Active Chat"
msgstr "Messaedje intrant e berdelaedje ovrant"

#: data/ktelepathy.notifyrc:597
msgctxt "Comment"
msgid "An incoming message in the active chat window has been received"
msgstr "On messaedje intrant a stî rçî el finiesse di berdelaedje ovrante"

#: data/ktelepathy.notifyrc:641
msgctxt "Name"
msgid "Outgoing Message"
msgstr "Messaedje rexhant"

#: data/ktelepathy.notifyrc:679
msgctxt "Comment"
msgid "An outgoing message has been sent"
msgstr "On messaedje rexhant a stî evoyî"

#: data/ktelepathy.notifyrc:723
msgctxt "Name"
msgid "Highlight"
msgstr "Mete e-n evidince"

#: data/ktelepathy.notifyrc:762
msgctxt "Comment"
msgid "A highlighted message has been received"
msgstr "On messaedje metou e-n evidince a stî rçî"

#: data/ktelepathy.notifyrc:805
msgctxt "Name"
msgid "Buzz/Nudge"
msgstr "Halcotmint"

#: data/ktelepathy.notifyrc:842
msgctxt "Comment"
msgid "A contact has sent you a buzz/nudge"
msgstr "On soçon vos a avoyî on halcotmint"

#: data/ktelepathy.notifyrc:884
msgctxt "Name"
msgid "Message Dropped"
msgstr "Messaedje abandné"

#: data/ktelepathy.notifyrc:922
msgctxt "Comment"
msgid "A message was filtered by the Privacy Plugin"
msgstr "On messaedje a stî passé al passete pal module di privaceye"

#: data/ktelepathy.notifyrc:964
msgctxt "Name"
msgid "Service Message"
msgstr "Messaedje di siervice"

#: data/ktelepathy.notifyrc:1002
msgctxt "Comment"
msgid "A service message has been received (e.g. authorization request)"
msgstr ""
"On messaedje di siervice a stî rçî (ene dimande d' otorijhåcion, metans)"

#: data/ktelepathy.notifyrc:1047
msgctxt "Name"
msgid "New incoming chat"
msgstr "Novea berdelaedje intrant"

#: data/ktelepathy.notifyrc:1084
msgctxt "Comment"
msgid "A new instant message has been received"
msgstr "On novea messaedje sol moumint a stî rçî"

#: data/ktelepathy.notifyrc:1126
msgctxt "Name"
msgid "Incoming file transfer"
msgstr "Berwetaedje di fitchî intrant"

#: data/ktelepathy.notifyrc:1163
msgctxt "Comment"
msgid "An incoming file transfer request has been received"
msgstr "Ene dimande di berwetaedje di fitchî intrant a stî rçî"

#: data/ktelepathy.notifyrc:1206
msgctxt "Name"
msgid "Incoming call"
msgstr "Houcaedje intrant"

#: data/ktelepathy.notifyrc:1243
msgctxt "Comment"
msgid "An incoming audio/video call request has been received"
msgstr "Ene dimande di houcaedje odio/videyo a stî rçî"

#: data/ktelepathy.notifyrc:1287
msgctxt "Name"
msgid "Chatstyle Install Request"
msgstr "Dimande d' astalaedje d' on stîle di berdelaedje"

#: data/ktelepathy.notifyrc:1328
msgctxt "Name"
msgid "Chatstyle Installed Successfully"
msgstr "Stîle di berdelaedje astalé comifåt"

#: data/ktelepathy.notifyrc:1369
msgctxt "Name"
msgid "Chatstyle Installation Failed"
msgstr "L' astalaedje do stîle di berdelaedje a fwait berwete"

#: data/ktelepathy.notifyrc:1410
msgctxt "Name"
msgid "Emoticonset Install Request"
msgstr "Dimande d' astalaedje d' on djeu d' xhinêyes"

#: data/ktelepathy.notifyrc:1451
msgctxt "Name"
msgid "Emoticonset Installed Successfully"
msgstr "Djeu di xhinêyes astalé comifåt "

#: data/ktelepathy.notifyrc:1493
msgctxt "Name"
msgid "Emoticonset Installation failed"
msgstr "L' astalaedje do djeu di xhinêyes a fwait berwete"

#: data/ktelepathy.notifyrc:1533
msgctxt "Name"
msgid "Contact status changed"
msgstr "Li statut do soçon a candjî"

#: data/ktelepathy.notifyrc:1562
msgctxt "Comment"
msgid "A contact has changed their status"
msgstr "On soçon a candjî s' sitatut"
