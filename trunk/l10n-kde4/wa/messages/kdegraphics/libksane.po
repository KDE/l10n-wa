#: ksane_viewer.cpp:90 ksane_widget.cpp:176
msgid "Zoom In"
msgstr "Zoumer"

#: ksane_viewer.cpp:93 ksane_widget.cpp:179
msgid "Zoom Out"
msgstr "Diszoumer"

#: ksane_viewer.cpp:96 ksane_widget.cpp:182
msgid "Zoom to Selection"
msgstr "Zoumer sol tchoes"

#: ksane_viewer.cpp:99 ksane_widget.cpp:185
msgid "Zoom to Fit"
msgstr "Zoumer po forrimpli"

#: ksane_widget.cpp:100
#, kde-format
msgid "Authentication required for: %1"
msgstr ""

#: ksane_widget.cpp:188
msgid "The lamp is warming up!"
msgstr "Li lampe tchôfe!"

#: ksane_widget.cpp:201
msgid "Cancel current scan operation"
msgstr "Rinoncî a l' operåcion d' sicanaedje do moumint"

#: ksane_widget.cpp:206
msgid "Scan Preview Image"
msgstr "Sicaner l' imådje di prévoeyaedje"

#: ksane_widget.cpp:207
msgctxt "Preview button text"
msgid "Preview"
msgstr "Prévoeyaedje"

#: ksane_widget.cpp:210
msgid "Scan Final Image"
msgstr "Sicaner l' imådje di fén"

#: ksane_widget.cpp:211
msgctxt "Final scan button text"
msgid "Scan"
msgstr "Sicaner"

#: ksane_widget.cpp:249
msgid "Basic Options"
msgstr "Tchuzes di båze"

#: ksane_widget.cpp:255
msgid "Other Options"
msgstr "Ôtès tchuzes"

#: ksane_widget.cpp:293
msgid "No scanner device has been found."
msgstr "Dji n' a trové nole sicanrece."

#: ksane_widget.cpp:304
msgid "Select Scanner"
msgstr "Tchoezi Scanrece"

#: ksane_widget.cpp:471 ksane_widget.cpp:511
msgid ""
"The image data contained 16 bits per color, but the color depth has been "
"truncated to 8 bits per color."
msgstr ""
"Les dnêyes di l' imådje aveut 16 bites pa coleurs mins l' parfondeu del "
"coloeur a stî côpêye a 8 bites pa coleur."

#: ksane_widget_private.cpp:312
msgid "Separate color intensity tables"
msgstr "Mete a pårt les tåves d' intinsité des coleurs"

#: ksane_widget_private.cpp:1151 ksane_widget_private.cpp:1241
msgid "The image format is not (yet?) supported by libksane!"
msgstr "Li cogne d' imådje n' est nén (co?) sopoirté pa libksane!"

