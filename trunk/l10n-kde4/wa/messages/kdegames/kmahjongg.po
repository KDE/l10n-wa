msgid "New Game"
msgstr "Novea djeu"

#: kmahjongg.cpp:243
msgid "Enter game number:"
msgstr "Diner on limero d' djeu:"

#: kmahjongg.cpp:273
msgid "General"
msgstr "Djenerå"

#: kmahjongg.cpp:274
msgid "Board layout"
msgstr "Adjinçmint do platea"

#: kmahjongg.cpp:371
msgid "You have won!"
msgstr "Vos avoz wangnî!"

#: kmahjongg.cpp:412
#, kde-format
msgid "Game number: %1"
msgstr "Limero do djeu: %1"

#: kmahjongg.cpp:422
#, kde-format
msgid "Removed: %1/%2  Combinations left: %3"
msgstr "Fwaits: %1/%2  Combinåcions dmorant: %3"

#: kmahjongg.cpp:488
msgid "Load Game"
msgstr "Tcherdjî djeu"

#: kmahjongg.cpp:500
msgid "Could not read from file. Aborting."
msgstr "Dji n' a savou lére do fitchî. Dji lai toumer."

#: kmahjongg.cpp:510
msgid "File is not a KMahjongg game."
msgstr "Li fitchî n' est nén on djeu Mahjongg."

#: kmahjongg.cpp:523
msgid "File format not recognized."
msgstr "Sôre di fitchî nén ricnoxhowe."

#: kmahjongg.cpp:560
msgid "Save Game"
msgstr "Schaper djeu"

#: kmahjongg.cpp:577
msgid "Could not write saved game."
msgstr "Dji n' a savou scrire li djeu a schaper."

