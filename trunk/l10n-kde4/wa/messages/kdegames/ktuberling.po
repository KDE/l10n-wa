#: toplevel.cpp:297
msgid ""
"The saved file is from an old version of KTuberling and unfortunately can "
"not be open with this version."
msgstr ""
"Li fitchî schapé vént d' ene viye modêye di Monsieu Crompire et målureuzmint "
"ni pout nén esse drovou avou cisse modêye."

#: toplevel.cpp:301
msgid "Could not load file."
msgstr "Dji n' a savou tcherdjî l' fitchî."

#: toplevel.cpp:322 toplevel.cpp:351
msgid "Only saving to local files is currently supported."
msgstr "Pol moumint i gn a ki l' schapaedje so on fitchî locå di sopoirté."

#: toplevel.cpp:337 toplevel.cpp:372
msgid "Could not save file."
msgstr "Dji n' a savou schaper l' fitchî."

#: toplevel.cpp:359
msgid "Unknown picture format."
msgstr "Cogne d' imådje nén cnoxhowe."

#: toplevel.cpp:382
#, kde-format
msgid "Print %1"
msgstr "Imprimer %1"

#: toplevel.cpp:388
msgid "Could not print picture."
msgstr "Dji n' a savou imprimer l' imådje."

#: toplevel.cpp:391
msgid "Picture successfully printed."
msgstr "Imådje imprimêye comifåt."

