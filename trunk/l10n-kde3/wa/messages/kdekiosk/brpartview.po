#: konq_run.cc:145
msgid ""
"There appears to be a configuration error. You have associated Konqueror with "
"%1, but it cannot handle this file type."
msgstr ""
"Dj' a l' idêye k' ene sacwè n' va nén dins voste apontiaedje. Vos avoz assoçné "
"Konqueror avou %1, mins i n' sait cwè fé avou cisse sôre di fitchî la."

#: konq_run.cc:266
msgid "Do you really want to execute '%1'?"
msgstr "Voloz vs po do bon enonder «%1»?"

#: konq_run.cc:280
msgid "Open '%1' using '%2'?"
msgstr "Drovi «%1» avou «%2»?"

#: konq_run.cc:282
msgid "Open '%1'?"
msgstr "Drovi «%1»?"

#: konq_run.cc:285
msgid "Save to Disk"
msgstr "Schaper sol deure plake"
