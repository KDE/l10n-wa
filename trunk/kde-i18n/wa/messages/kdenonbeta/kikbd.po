#: main.cpp:16
msgid "International Keyboard Selector"
msgstr "Tchoezixheu di tapreces eternåcionåles"

#: main.cpp:17
msgid "Run time selector for keyboard layout on the desktop or on individual windows"
msgstr ""

#: main.cpp:21
msgid "Current maintainer"
msgstr "Tineu a djoû pol moumint"

#: main.cpp:23
msgid "Original author"
msgstr "Prumî oteur"

#: main.cpp:24
msgid "Bug fixing"
msgstr "Coridjaedje di bugs"

#: kikbd.cpp:173
msgid ""
"Only one instance of the international keyboard configuration\n"
"can run at a given moment."
msgstr ""

#: kikbd.cpp:175
msgid "Already running"
msgstr "Dedja en alaedje"

#: kikbd.cpp:240
msgid ""
"X codes \"%1\" file does not exist.\n"
"Using previously default X codes."
msgstr ""
"Li fitchî des côdes X «%1» n' egzistêye nén.\n"
"Dji m' sieve des prémetous côdes X."

#: kikbd.cpp:267
msgid ""
"Keyboard map \"%1\" does not exists.\n"
"Skipping this map."
msgstr ""
"Li mape del taprece «%1» n' egzistêye nén.\n"
"Djel passe."

#: kikbd.cpp:283
msgid "Setup"
msgstr "Apontyî"

#: kikbd.cpp:305 kikbd.cpp:318
msgid ""
"Can not remove %1 from Modifiers.\n"
msgstr ""
"Dji n' sai oister %1 foû des tapes candjreces.\n"

#: kikbd.cpp:308
msgid ""
"Can not add %1 to Modifier number 3.\n"
msgstr ""
"Dji n' sai radjouter %1 al tape candjrece limero 3.\n"

#: kikbd.cpp:330
msgid ""
"Can not set Mode Switch as %1 for keyboard %2.\n"
"Alt symbols disabled"
msgstr ""
"Dji n' sai defini li discandje di môde come %1 pol taprece %2.\n"
"Les simboles Alt sont disclitchîs"

#: kikbd.cpp:352
msgid ""
"Can't remove Caps Lock from Modifiers.\n"
"Caps Lock Emulation disabled"
msgstr ""
"Dji n' sai oister Caps Lock foû des tapes candjreces.\n"
"Li xhinaedje di Caps Lock est disclitchî"

#: kikbd.cpp:1009
msgid ""
"You're about to quit the \"International Keyboard\" tool.\n"
" Do you want to have it autostarted at your next login?"
msgstr ""
"Vos estoz po cwiter l' usteye \"Taprece eternåcionåle\".\n"
"Voloz vs k' ele si renonde tote seule cwand vos rmousroz è voste éndjole?"

#: kikbd.cpp:1012
msgid "Exiting International Keyboard"
msgstr "Dji mousse foû del taprece eternåcionåle"

#: keysyms.cpp:18
msgid "KeyMap: can't allocate memory"
msgstr "Mape des tapes: dji n' sai alower del memwere"

#: keysyms.cpp:73
msgid ""
"Can't find symbol \"%1\".\n"
"Maybe your default X codes do not match.\n"
"You can preset X codes from section \"Advanced\"\n"
"in the configuration program."
msgstr ""
"Dji n' trove nén li simbole «%1».\n"
"Motoit les prémetous côdes X ni corespondèt nén.\n"
"Vos poloz apontyîz les côdes X el pårteye «Po les spepieus»\n"
"do programe d' apontiaedje."

#: keysyms.cpp:78
msgid "KeyMap: can't find symbol \"%1\"."
msgstr "Mape des tapes: dji n' trove nén li simbole «%1»."

#: keysyms.cpp:88
msgid "KeyMap: can't read keycode \"%1\"."
msgstr "Mape des tapes: dji n' comprind nén li côde del tape «%1»."

#: keysyms.cpp:94
msgid "KeyMap: keycode \"%1\" is out of range."
msgstr "Mape des tapes: li côde di tape «%1» a passé houte."

