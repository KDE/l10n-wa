#: kio_finger.cpp:182
msgid "Could not find the Perl program on your system, please install."
msgstr "Dji n' sai trover li programe «perl» so voste éndjole, i vos l' fåt astaler."

#: kio_finger.cpp:195
msgid "Could not find the Finger program on your system, please install."
msgstr "Dji n' sai trover li programe «finger» so voste éndjole, i vos l' fåt astaler."

#: kio_finger.cpp:208
msgid "kio_finger Perl script not found."
msgstr "Dji n' a nén trové li scripe perl kio_finger."

#: kio_finger.cpp:220
msgid "kio_finger CSS script not found. Output will look ugly."
msgstr "Dji n' a nén trové li scripe CSS kio_finger. Li rexhowe ni srè nén foirt bele."

