#: main.cpp:72
msgid "&Standard shortcuts"
msgstr "Rascoûrtîs E&standårds"

#: main.cpp:80
msgid "&Global shortcuts"
msgstr "Rascoûrtîs &globås"

#: main.cpp:88
msgid "usage: kcmkeys [-init | {standard,global}]\n"
msgstr "po s' è siervi: kcmkeys [-init | {estandard,globa}]\n"

#: main.cpp:132
msgid "Key binding settings"
msgstr "Apontiaedje des tapes"

#: keyconfig.cpp:106
msgid "Current scheme"
msgstr "Tapes pol moumint"

#: keyconfig.cpp:108
msgid "KDE default"
msgstr "Tchwezi por vos pa KDE"

#: keyconfig.cpp:115
msgid "&Key scheme"
msgstr "A&rindjmint des tapes"

#: keyconfig.cpp:126
msgid "&Add ..."
msgstr "R&adjouter"

#: keyconfig.cpp:148
msgid "&Save changes"
msgstr "&Schaper les candjmints"

#: keyconfig.cpp:211
msgid "Error removing scheme"
msgstr "Yåk n' a nén stî come dji sayîve do waester cist arindjmint"

#: keyconfig.cpp:212
msgid ""
"This key scheme could not be removed.\n"
"Perhaps you do not have permission to alter the file\n"
"system where the key scheme is stored."
msgstr ""
"Dji n' a savu waester cist arindjmint di tapes la.\n"
"Mutwè est-ce pace ki vos n' avoz nén li permission do candjî\n"
"li fitchî sistinme ki l' arindjmint est scrît ddins."

#: keyconfig.cpp:343
msgid "Naming conflict"
msgstr "Ci no la egzisteye dedja"

#: keyconfig.cpp:344
msgid ""
"Please choose a unique name for the new key\n"
"scheme. The one you entered already appears\n"
"in the key scheme list."
msgstr ""
"Li novea arindjmint des tapes doet avu on no bén\n"
"da lu. Li ci ki vos vnoz do mete egzisteye dadja\n"
"el djîveye des arindjmints."

#: savescm.cpp:18
msgid "Add a key scheme"
msgstr "Radjouter èn arindjmint di tape"

#: savescm.cpp:32
msgid ""
"&Enter a name for the new key scheme\n"
"to be added to your personal list.\n"
"\n"
"The keys currently used in the preview will\n"
"be copied into this scheme to begin with."
msgstr ""
"&Dinez on no å novea arindjmint des tapes. Ci no\n"
"la serè radjouté a vosse djîveye da vos.\n"
"\n"
"Les tapes ki siervèt pol moumint è purnea 'Vey divant' vont\n"
"esse copieye è l' arindjmint po cmincî."

