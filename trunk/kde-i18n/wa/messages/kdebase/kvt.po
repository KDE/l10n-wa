#: main.C:1478
msgid "Permitted arguments are:\n"
msgstr "Les årgumints k' on pout bén sont:\n"

#: main.C:1479
msgid ""
"-e <command> <arg> ...    execute command with ars - must be last argument\n"
msgstr ""
"-e <command> <arg> ...    les cmandes d' enondaedje avou ars - divèt esse li dierin årgumint\n"

#: main.C:1480
msgid "-display <name>           specify the display (server)\n"
msgstr "-display <name>           dîre ké hågnaedje (sierveu)\n"


#: main.C:1481
msgid "-vt_geometry <spec>       the initial vt window geometry\n"
msgstr "-vt_geometry <spec>       li jometreye do purnea vt å cminçmint\n"

#: main.C:1482
msgid "-print-pipe <name>        specify pipe for vt100 printer\n"
msgstr "-print-pipe <name>        dire li bûze po les scrîreces vt100\n"

#: main.C:1483
msgid "-vt_bg <colour>           background color\n"
msgstr "-vt_bg <colour>           coleur di fond\n"

#: main.C:1484
msgid "-vt_fg <colour>           foreground color\n"
msgstr "-vt_fg <colour>           coleur di dvant\n"

#: main.C:1485
msgid "-vt_font <fontname>       normal font\n"
msgstr "-vt_font <fontname>      fonte normåle\n"

#: main.C:1486
msgid "-no_font_hack             turn off Qt font bug workaround\n"
msgstr "-no_font_hack             ni nén eployî li metôde po passer hute do bug po les fontes di Qt\n"

#: main.C:1487
msgid "-vt_size <size>           tiny, small, normal, large, huge\n"
msgstr "-vt_size <size>           foirt pitit, pitit, normå, grand, foirt grand\n"

#: main.C:1488
msgid "-linux                    set up kvt to mimic linux-console\n"
msgstr "-linux                   apontyî kvt por lu chiner ene conzole linux\n"

#: main.C:1489
msgid "-no_menubar               hide the menubar\n"
msgstr "-no_menubar               catchî li bår ås menus\n"

#: main.C:1490
msgid "-no_scrollbar             hide the scrollbar\n"
msgstr "-no_scrollbar             catchî l' assinceur\n"

#: main.C:1491
msgid ""
"-T <text>                 text in window titlebar \n"
"                          (Obsolete. Use -caption instead)\n"
msgstr ""
"-T <text>                 sicrît è bår di tite do purnea\n"
"                          (N' est pus eployî. Eployîz pus rade -caption)\n"

#: main.C:1493
msgid "-tn <TERM>                Terminal type. Default is xterm.\n"
msgstr "-tn <TERM>                sôrte di terminå. Tchwezi por vos: xterm.\n"

#: main.C:1494
msgid "-C                        Capture system console message\n"
msgstr "-C                        Si sovni des messaedjes sistinmes del conzole\n"

#: main.C:1495
msgid "-n <text>                 name in icon or icon window\n"
msgstr "-n <text>                 no è l' imådjete ou è purnea di l' imådjete\n"

#: main.C:1496
msgid ""
"-7                        run in 7 bit mode\n"
"-8                        run in 8 bit mode\n"
msgstr ""
"-7                        enonder è môde 7 bits\n"
"-8                        enonder è môde 8 bits\n"

#: main.C:1498
msgid ""
"-ls                       initiate kvt's shell as a login shell\n"
"-ls-                      initiate kvt's shell as a non-login shell "
"(default)\n"
msgstr ""
"-ls                       enonder kvt come po moussî è sistinme\n"
"-ls-                      enonder kvt nén comepo moussî è sistinme"
"(tchwezi por vos)\n"

#: main.C:1500
msgid ""
"-meta <arg>               handle Meta with ESCAPE prefix, 8THBIT set, or "
"ignore\n"
msgstr ""
"-meta <arg>               manaedjî Meta avou li betchete ESCAPE, 8THBIT set, ou "
"passer hute\n"

#: main.C:1501
msgid "-sl <number>              save number lines in scroll-back buffer\n"
msgstr "-sl <number>              nombe di royes a schaper po rmonter èn erî\n"

#: main.C:1502
msgid ""
"-pageup <keysym>          use hot key alt-keysym to scroll up through the "
"buffer\n"
"-pagedown <keysym>        use hot key alt-keysym to scroll down through "
"buffer\n"
msgstr ""
"-pageup <keysym>          eployî les tapes alt-keysym po rmonter "
"èn erî\n"
"-pagedown <keysym>         eployî les tapes alt-keysym po ridschinde"
"èn avant\n"

#: main.C:1506
msgid ""
"-grk9\t\tgreek kbd = ELOT 928 (default)\n"
"-grk4\t\tgreek kbd = IBM 437\n"
msgstr ""
"-grk9\t\tgreek kbd = ELOT 928 (tchwezi por vos)\n"
"-grk4\t\tgreek kbd = IBM 437\n"

