#: kikbd.cpp:116
msgid "KDE International Keyboard already started on this display."
msgstr "La taprece eternacionåle di KDE est ddja enondeye"

#: kikbd.cpp:288
#, c-format
msgid ""
"X codes \"%s\" file does not exist.\n"
"Using X default codes."
msgstr ""
"Li fitchî des côdes X \"%s\" n' egzisteye nén.\n"
"Dji m' sieve des côdes X tchwezi por vos."

#: kikbd.cpp:313
#, c-format
msgid ""
"Keyboard map \"%s\" does not exists.\n"
"Skipping this map."
msgstr ""
"Li mape del taprece \"%s\" n' egzisteye nén.\n"
"Djel passe."

#: kikbd.cpp:330
msgid "Setup"
msgstr "Apontyî"

#: kikbd.cpp:345 kikbd.cpp:358
#, c-format
msgid "Can not remove %s from Modifiers.\n"
msgstr "Dji n' sai waester %s foû des tapes candjreces.\n"

#: kikbd.cpp:348
#, c-format
msgid "Can not add %s to Modifier number 3.\n"
msgstr "Dji n' sai radjouter %s al tape candjrece limerô 3.\n"

#: kikbd.cpp:370
#, c-format
msgid ""
"Can not set Mode Switch as %s for keyboard %s.\n"
"Alt symbols disabled"
msgstr ""
"Dji n' sai defini li discandje di môde come %s pol taprece %s.\n"
"Les simboles Alt sont disclitchîs"


#: kikbd.cpp:392
msgid ""
"Cannot remove Caps Lock from Modifiers.\n"
"Caps Lock Emulation disabled"
msgstr ""
"Dji n' sai waester Caps Lock foû des tapes candjreces.\n"
"Li chinaedje di Caps Lock est disclitchî"

#: kikbd.cpp:1003
msgid "Exiting International Keyboard"
msgstr "Dji mousse foû del taprece eternacionåle"

#: kikbd.cpp:1004
msgid ""
"You're about to quit the \"International Keyboard\" tool.\n"
" Do you want to have it autostarted at your next login?"
msgstr ""
"Vos estoz po cwiter l' usteye \"Taprece eternacionåle\".\n"
"Voloz-ve k' ele si renonde tote seule cwand vos rmousroz è voste endjole?"

#: keymap.cpp:181
msgid "KeyMap: cannot allocate memory"
msgstr "Mape des tapes: dji n' sai pårti li memwere"

#: keymap.cpp:228
#, c-format
msgid ""
"Can not find symbol \"%s\".\n"
"May be your default X codes does not match.\n"
"You can preset X codes in \"Advanced\" section\n"
"of configuration program."
msgstr ""
"Dji n' trove nén li simbole \"%s\".\n"
"Mutwè les côdes X tchwezi por vos ni corespondèt nén.\n"
"Vos poloz apontyîz les côdes X el pårteye \"Po les spepieus\"\n"
"do programe d' apontiaedje."

#: keymap.cpp:233
#, c-format
msgid "KeyMap: can not find symbol \"%s\"."
msgstr "Mape des tapes: dji n' trove nén li simbole \"%s\"."

#: keymap.cpp:241
#, c-format
msgid "KeyMap: do not understand key code \"%s\"."
msgstr "Mape des tapes: dji n' comrind nén li côde del tape \"%s\"."

#: keymap.cpp:247
#, c-format
msgid "KeyMap: key code \"%s\" go out of range."
msgstr "Mape des tapes: li côde di tape \"%s\" a passé hute."

