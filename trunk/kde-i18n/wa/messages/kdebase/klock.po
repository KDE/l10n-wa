"\n"
"N' eployîz nén -test avou -lock.\n"
"Siervoz vos pus rade di klock..\n"
"\n"

#: main.cpp:586
#, c-format
msgid ""
"Usage: %s -install|-setup|-test|-desc|-preview wid|-inroot\n"
"       [-corners xxxx] [-delay num] [-lock] [-allow-root] [-nice num]\n"
msgstr ""
"Po s' è siervi: %s -install|-setup|-test|-desc|-preview wid|-inroot\n"
"                [-corners xxxx] [-delay num] [-lock] [-allow-root] [-nice num]\n"

# xxx What are nice values?
#: main.cpp:589
msgid ""
"  -corners xxxx     Placing cursor in corner performs action:\n"
"                     x = i  no action (ignore)\n"
"                     x = s  save screen\n"
"                     x = l  lock screen\n"
"                    order: top-left, top-right, bottom-left, bottom-right\n"
"  -delay num        Amount of idle time before screen saver\n"
"                     starts  (default 10min)\n"
"  -desc             Print the screen saver's description to stdout\n"
"  -install          Install screen saver\n"
"  -lock             Require password to stop screen saver\n"
"  -allow-root       Accept root password to unlock\n"
"  -nice num         Run with specified nice value\n"
"\n"
"  -preview wid      Run in the specified XWindow\n"
"  -inroot           Run in the root window\n"
"  -setup            Setup screen saver\n"
"  -test             Invoke the screen saver immediately\n"
msgstr ""
"  -corners xxxx     Aminer li curseur el coine fwait fé:\n"
"                     x = i  rén (passer)\n"
"                     x = s  schaper li waitroûle\n"
"                     x = l  serer li waitroûle al clé\n"
"                    rindjmint: al copete a gautche, al copete a droete,\n"
"                               al valeye a gautche, al valeye a droete\n"
"  -delay num        Tins ki passe divant ki li spårgneu di waitroûle\n"
"                    s' enonde (tchwezi por vos: 10 munutes)\n"
"  -desc             Po rexhe li discrîjhaedje do spårgneu di waitroûle so stdout\n"
"  -install          Astaler li spårgneu di waitroûle\n"
"  -lock             Dimande on scret po-z arester li spårgneu di waitroûle\n"
"  -allow-root       Prind li scret di 'root' po-z arester li spårgneu\n"
"  -nice num         Enonder avou les djoleyès valixhances dineyes\n"
"\n"
"  -preview wid      Enonder è purnea Xwindow dineye\n"
"  -inroot           Enonder è purnea raecene\n"
"  -setup            Apontyî li spårgneu di waitroûle\n"
"  -test             Sayî li spårgneu sol côp\n"

