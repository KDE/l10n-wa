msgstr "Li no ratoûrné do programe."

#: main.cpp:54
msgid "The PID of the program"
msgstr "Li PID do programe."

#: main.cpp:55
msgid "The program was started by kdeinit"
msgstr "Li programe a stî enondé pa kdeinit."

