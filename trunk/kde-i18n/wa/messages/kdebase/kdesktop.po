#: minicli.cpp:429
msgid "You don't exist!\n"
msgstr "Vos n' egzistez nén!\n"

#: minicli.cpp:457
msgid "Incorrect password! Please try again."
msgstr "Ci scret la n' est nén djusse!  Sayîz co on côp."

#: minicli.cpp:571
