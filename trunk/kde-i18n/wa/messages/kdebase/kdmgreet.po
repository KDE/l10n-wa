msgstr ""
"Vosse conte espire dimwin.\n"
"Vosse conte espire dins %n djoûs."

#: kgreeter.cpp:717
msgid "Your password expires today."
msgstr "Vosse sicret espire ådjourdu."

#: kgreeter.cpp:720
