#: kgreeter.cpp:636
msgid ""
"A critical error occurred.\n"
"Please look at KDM's logfile for more information\n"
"or contact your system administrator."
msgstr ""
"I gn a-st avou ene aroke moirt.\n"
"Loukîz li fitchî djournå di KDM po pus di racsegnes\n"
"oudonben voeyoz avou l' manaedjeu di vosse sistinme s' i vs plait."

#: kgreeter.cpp:641
msgid "Home directory not available."
msgstr "Li ridant måjhon n' est nén disponibe."

#: kgreeter.cpp:644
msgid "Root logins are not allowed."
msgstr "L' elodjaedje di root n' est nén otorijhî."

#: kgreeter.cpp:648
msgid "Your login shell is not listed in /etc/shells."
msgstr "Vosse shell d' elodjaedje n' est nén djîstré e /etc/shells."

#: kgreeter.cpp:651
msgid "Your account has expired."
msgstr "Vosse conte a-st espiré."

#: kgreeter.cpp:654
msgid "Your password has expired."
msgstr "Vosse sicret a-st espiré."

#: kgreeter.cpp:657
msgid ""
"You are not allowed to login\n"
"at the moment."
msgstr ""
"Vos n' avoz nén l' otorijhåcion\n"
"di vs elodjî pol moumint."

#: kgreeter.cpp:674
msgid ""
"Logins are not allowed at the moment.\n"
"Try again later."
msgstr ""
"Les elodjaedjes èn sont nén otorijhîs pol moumint.\n"
"Rissayîz pus tård."

#: kgreeter.cpp:709
msgid "Your account expires today."
msgstr "Vosse conte espire ådjourdu."

