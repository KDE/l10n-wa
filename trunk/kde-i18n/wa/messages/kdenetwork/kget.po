#: kmainwidget.cpp:417
msgid ""
"<b>Resume</b> button starts selected transfers\n"
"and sets their mode to <i>queued</i>."
msgstr ""
"Li boton <b>Rataker</b> enonde les transfers\n"
"tchoezis, eyet mete leu môde a <i>el caweye</i>."

#: kmainwidget.cpp:420
msgid ""
"<b>Pause</b> button stops selected transfers\n"
"and sets their mode to <i>delayed</i>."
msgstr ""

#: kmainwidget.cpp:423
msgid ""
"<b>Delete</b> button removes selected transfers\n"
"from the list."
msgstr ""

#: kmainwidget.cpp:426
msgid ""
"<b>Restart</b> button is a convenience button\n"
"that simply does Pause and Resume."
msgstr ""

#: kmainwidget.cpp:429
msgid ""
"<b>Queued</b> button sets the mode of selected\n"
"transfers to <i>queued</i>.\n"
"\n"
"It is a radio button, you can select between\n"
"three modes."
msgstr ""

#: kmainwidget.cpp:432
msgid ""
"<b>Scheduled</b> button sets the mode of selected\n"
"transfers to <i>scheduled</i>.\n"
"\n"
"It is a radio button, you can select between\n"
"three modes."
msgstr ""

#: kmainwidget.cpp:435
msgid ""
"<b>Delayed</b> button sets the mode of selected\n"
"transfers to <i>delayed</i>.This also causes the selected transfers to "
"stop.\n"
"\n"
"It is a radio button, you can select between\n"
"three modes."
msgstr ""

#: kmainwidget.cpp:438
msgid ""
"<b>Preferences</b> button opens a preferences dialog\n"
"where you can set various options.\n"
"\n"
"Some of these options can be more easily set using the toolbar."
msgstr ""

#: kmainwidget.cpp:441
msgid ""
"<b>Log window</b> button opens a log window.\n"
"The log window records all program events that occur\n"
"while KGet is running."
msgstr ""

#: kmainwidget.cpp:444
msgid ""
"<b>Paste transfer</b> button adds a URL from\n"
"the clipboard as a new transfer.\n"
"\n"
"This way you can easily copy&paste URLs between\n"
"applications."
msgstr ""

#: kmainwidget.cpp:447
msgid ""
"<b>Expert mode</b> button toggles the expert mode\n"
"on and off.\n"
"\n"
"Expert mode is recommended for experienced users.\n"
"When set, you will not be \"bothered\" by confirmation\n"
"messages.\n"
"<b>Important!</b>\n"
"Turn it on if you are using auto-disconnect or\n"
"auto-shutdown features and you want KGet to disconnect \n"
"or shut down without asking."
msgstr ""

#: kmainwidget.cpp:450
msgid ""
"<b>Use last directory</b> button toggles the\n"
"use-last-directory feature on and off.\n"
"\n"
"When set, KGet will ignore the directory settings\n"
"and put all new added transfers into the directory\n"
"where the last transfer was put."
msgstr ""

#: kmainwidget.cpp:453
msgid ""
"<b>Auto disconnect</b> button toggles the auto-disconnect\n"
"mode on and off.\n"
"\n"
"When set, KGet will disconnect automatically\n"
"after all queued transfers are finished.\n"
"\n"
"<b>Important!</b>\n"
"Also turn on the expert mode when you want KGet\n"
"to disconnect without asking."
msgstr ""

#: kmainwidget.cpp:456
msgid ""
"<b>Auto shutdown</b> button toggles the auto-shutdown\n"
"mode on and off.\n"
"\n"
"When set, KGet will quit automatically\n"
"after all queued transfers are finished.\n"
"<b>Important!</b>\n"
"Also turn on the expert mode when you want KGet\n"
"to quit without asking."
msgstr ""

#: kmainwidget.cpp:459
msgid ""
"<b>Offline mode</b> button toggles the offline mode\n"
"on and off.\n"
"\n"
"When set, KGet will act as if it was not connected\n"
"to the Internet.\n"
"\n"
"You can browse offline, while still being able to add\n"
"new transfers as queued."
msgstr ""

#: kmainwidget.cpp:462
msgid ""
"<b>Auto paste</b> button toggles the auto-paste mode\n"
"on and off.\n"
"\n"
"When set, KGet will periodically scan the clipboard\n"
"for URLs and paste them automatically."
msgstr ""

#: kmainwidget.cpp:465
msgid ""
"<b>Drop target</b> button toggles the window style\n"
"between a normal window and a drop target.\n"
"\n"
"When set, the main window will be hidden and\n"
"instead a small shaped window will appear.\n"
"\n"
"You can show/hide a normal window with a simple click\n"
"on a shaped window."
msgstr ""

