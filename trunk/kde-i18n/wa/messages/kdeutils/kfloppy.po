#: floppy.cpp:292
#, c-format
msgid ""
"Cannot access %s\n"
"Make sure that the device exists and that\n"
"you have write permission to it."
msgstr ""
"Dji n' a seu avni a %s\n"
"Estoz-ve sheur(e) ki ciste usteye egzisteye et\n"
"ki vos poloz bén scrîre dissu."

#: floppy.cpp:339
msgid ""
"Cannot find kfdformat\n"
"kfdformat is part of the KFloppy distribution.\n"
"Please install KFloppy properly."
msgstr ""
"Dji n' trove nén kfdformat\n"
"kfdformat e-st ene pårt di KFloppy.\n"
"Rastalez KFloppy comufåt."

#: floppy.cpp:355
msgid ""
"Cannot find kmke2fs\n"
"kmke2fs is part of the KFloppy distribution.\n"
"Please install KFloppy properly."
msgstr ""
"Dji n' trove nén kmke2fs\n"
"kmke2fs e-st ene pårt di KFloppy.\n"
"Rastalez KFloppy comufåt."

#: floppy.cpp:370
msgid ""
"Cannot find kmkdosfs\n"
"kmkdosfs is part of the KFloppy distribution.\n"
"Please install KFloppy properly."
msgstr ""
"Dji n' trove nén kmkdosfs\n"
"kmkdosfs e-st ene pårt di KFloppy.\n"
"Rastalez KFloppy comufåt."

#: floppy.cpp:430
msgid "Abort"
msgstr "Rinoncî"

#: floppy.cpp:478
msgid "Cannot start a new program: fork() failed."
msgstr "Dji n' parvén nén a-z enonder èn ôte programe: fork() a fwait berwete."

#: floppy.cpp:578 floppy.cpp:706
msgid ""
"Cannot access floppy or floppy drive\n"
"Please insert a floppy and make sure that you\n"
"have selected a valid floppy drive.\n"
msgstr ""
"Dji n' parvén nén a avni al plakete ou å mineu des plaketes\n"
"Metoz ene plakete è mineu et s' waitîz si vos avoz\n"
"tchûzi li bon mineu.\n"

#: floppy.cpp:593
#, c-format
msgid ""
"Cannot format: %s\n"
"%s"
msgstr ""
"Dji n' parvén nén a fôrmater: %s\n"
"%s"

#: floppy.cpp:640
#, c-format
msgid "Block %d is bad. Continuing ..."
msgstr "Li bloc %d est cromb, mins dji continuwe ..."

#: floppy.cpp:723
#, c-format
msgid ""
"Cannot create a filesystem on: %s\n"
"%s"
msgstr ""
"Dji n' parvén nén a fé on sistinme di fitchî so: %s\n"
"%s"

#: floppy.cpp:759
#, c-format
msgid ""
"The floppy was sucessfully formatted.\n"
"Blocks marked bad: %d\n"
"Raw Capacity: %d\n"
msgstr ""
"Li plakete est bén fôrmateye.\n"
"Sacwants blocs sont crombs: %d\n"
"Capacité: %d\n"

#: floppy.cpp:780
msgid "All files were sucessfully erased."
msgstr "Tos les fitchîs ont bén stî disfacés."

#: floppy.cpp:838
msgid "Creating Filesystem ..."
msgstr "Dji fwai on sistinme di fitchîs ..."

#: floppy.cpp:842
msgid "Verifying ..."
msgstr "Dji waite ..."

#: floppy.cpp:887
msgid ""
"Cannot start a new program\n"
"fork() failed."
msgstr ""
"Dji n' parvén nén a-z enonder on novea programe\n"
"fork() a fwait berwete."

#: floppy.cpp:913
msgid "Error while trying to determine whether floppy is mounted\n"
msgstr "Yåk n' a nén stî come dji waitîve si li plakete est monteye\n"

#: floppy.cpp:930
#, c-format
msgid ""
"%s is mounted.\n"
"Please unmount the floppy first."
msgstr ""
"%s est monté.\n"
"Dismontez li plakete po cmincî."

