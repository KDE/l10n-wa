#, c-format
msgid "Error formatting track %1."
msgstr "Åk n' a nén stî tot-z abwesnant li djive %1."

#: floppy.cpp:483 floppy.cpp:612 format.cpp:500
msgid ""
"Cannot access floppy or floppy drive.\n"
"Please insert a floppy and make sure that you have selected a valid floppy "
"drive."
msgstr ""
"Dji n' parvén nén a avni al plakete ou å mineu des plaketes\n"
"Metoz ene plakete e mineu et s' waitîz si vos avoz "
"tchoezi li bon mineu."

#: format.cpp:564
msgid "Cannot find a program to create FAT filesystems."
msgstr "Dji n' parvén nén a trover on programe po fé on sistinme di fitchîs FAT."

#: format.cpp:595
msgid "Cannot start FAT format program."
msgstr "Dji n' parvén nén a-z enonder li programe po les abwesnaedjes FAT."

#: format.cpp:639
msgid "Cannot find a program to create a UFS filesystems."
msgstr "Dji n' parvén nén a trover on programe po fé on sistinme di fitchîs UFS."

#: format.cpp:653
msgid "Cannot start UFS format program."
msgstr "Dji n' sai enonder li programe po les abwesnaedjes UFS."

#: format.cpp:710
msgid "Cannot find a program to create an ext2 filesystems."
msgstr "Dji n' parvén nén a trover on programe po fé on sistinme di fitchîs ext2."

#: format.cpp:725
msgid "Cannot start ext2 format program."
msgstr "Dji n' parvén nén a-z enonder li programe po les abwesnaedjes ext2."

