#: kio/global.cpp:312
#, c-format
msgid ""
"Error. Out of Memory.\n"
"%1"
msgstr ""
"Aroke. Pupont d' memwere\n"
"%1"

#: kio/global.cpp:315
#, c-format
msgid ""
"Unknown proxy host\n"
"%1"
msgstr ""
"Procsi nén cnoxhou\n"
"%1"

#: kio/global.cpp:318
msgid "Authorization failed, %1 authentication not supported"
msgstr "Li permetaedje a fwait berwete; l' aveurixhmint di %1 n' est nén sopoirté"

#: kio/global.cpp:321
#, c-format
msgid ""
"User canceled action\n"
"%1"
msgstr ""
"Uzeu a rnoncî\n"
"%1"

#: kio/global.cpp:324
#, c-format
msgid ""
"Internal error in server\n"
"%1"
msgstr ""
"Divintrinne aroke e sierveu\n"
"%1"

#: kio/global.cpp:327
#, c-format
msgid ""
"Timeout on server\n"
"%1"
msgstr ""
"Nole response do sierveu\n"
"%1"

#: kio/global.cpp:330
#, c-format
msgid ""
"Unknown error\n"
"%1"
msgstr ""
"Aroke nén cnoxhowe\n"
"%1"

#: kio/global.cpp:333
#, c-format
msgid ""
"Unknown interrupt\n"
"%1"
msgstr ""
"Côpaedje foû nén cnoxhou\n"
"%1"

#: kio/global.cpp:344
msgid ""
"Could not delete original file %1.\n"
"Please check permissions."
msgstr ""
"Dji n' sai disfacer li fitchî %1.\n"
"Waitîz si vs avoz les bons droets."

#: kio/global.cpp:347
msgid ""
"Could not delete partial file %1.\n"
"Please check permissions."
msgstr ""
"Dji n' sai disfacer li fitchî parciél %1.\n"
"Waitîz si vs avoz l' droet."

#: kio/global.cpp:350
msgid ""
"Could not rename original file %1.\n"
"Please check permissions."
msgstr ""
"Dji n' sai rlomer l' fitchî d' oridjene%1.\n"
"Waitîz si vs avoz l' droet."

#: kio/global.cpp:353
msgid ""
"Could not rename partial file %1.\n"
"Please check permissions."
msgstr ""
"Dji n' sai rlomer li fitchî parciél %1.\n"
"Waitîz si vs avoz l' droet."

#: kio/global.cpp:356
msgid ""
"Could not create symlink %1.\n"
"Please check permissions."
msgstr ""
"Dji n' sai fé li loyén simbolike %1.\n"
"Waitîz si vs avoz l' droet."

#: kio/global.cpp:362
msgid ""
"Could not write file %1.\n"
"Disk full."
msgstr ""
"Dji n' a nén parvinou a scrire %1.\n"
"Motoit li deure plake est ele rimpleye"

#: kio/global.cpp:365
#, c-format
msgid ""
"The source and destination are the same file.\n"
"%1"
msgstr ""
"Li fitchî sourdant eyet l' fitchî såme sont les minmes.\n"
"%1"

#: kio/global.cpp:371
msgid "%1 is required by the server, but is not available."
msgstr "Li sierveu a dandjî di %1, mins dji n' l' a nén."

#: kio/global.cpp:373
msgid "Access to restricted port in POST denied"
msgstr "Vos n' poloz nén eployî li pôrt restrint dins POST"

#: kio/global.cpp:376
msgid ""
"Unknown error code %1\n"
"%2\n"
"Please send a full bug report at http://bugs.kde.org."
msgstr ""
"Côde d' aroke nén cnoxhou: %1\n"
"%2\n"
"Gråces d' evoyî on rapoirt di bug a http://bugs.kde.org."

#: kio/global.cpp:386
#, c-format
msgid "Opening connections is not supported with the protocol %1"
msgstr "Li raloyaedje avou  l' protocole %1 n' est nén sopoirté"

#: kio/global.cpp:388
#, c-format
msgid "Closing connections is not supported with the protocol %1"
msgstr ""

#: kio/global.cpp:390
#, c-format
msgid "Accessing files is not supported with the protocol %1"
msgstr "Nén moyén d' eployî des fitchîs avou l' protocole %1"

#: kio/global.cpp:392
msgid "Writing to %1 is not supported"
msgstr "Li scrijhaedje dins %1 n' est nén sopoirté"

#: kio/global.cpp:394
#, c-format
msgid "There are no special actions available for protocol %1"
msgstr "Gn a nole accion especiåle di presse por vos pol protocole %1"

#: kio/global.cpp:396
#, c-format
msgid "Listing directories is not supported for protocol %1"
msgstr "Li listaedje des ridants n' est nén sopoirté på protocole %1"

#: kio/global.cpp:398
msgid "Retrieving data from %1 is not supported"
msgstr "Li rapexhaedje des dnêyes di %1 n' est nén sopoirté."

#: kio/global.cpp:400
msgid "Retrieving mime type information from %1 is not supported"
msgstr ""

#: kio/global.cpp:402
msgid "Renaming or moving files within %1 is not supported"
msgstr "Li rlomaedje et l' bodjaedje des fitchîs dvins %1 n' est nén sopoirté."

#: kio/global.cpp:404
#, c-format
msgid "Creating symlinks is not supported with protocol %1"
msgstr "Ci protocole ci ni permet nén do fé des loyéns simbolikes: %1"

#: kio/global.cpp:406
msgid "Copying files within %1 is not supported"
msgstr "Li copiaedje des fitchîs dvins %1 n' est nén sopoirté"

#: kio/global.cpp:408
msgid "Deleting files from %1 is not supported"
msgstr "Li disfaçaedje des fitchîs dvins %1 n' est nén sopoirté"

#: kio/global.cpp:410
#, c-format
msgid "Creating directories is not supported with protocol %1"
msgstr "Ci protocole ci ni permet nén do fé des ridants: %1"

#: kio/global.cpp:412
#, c-format
msgid "Changing the attributes of files is not supported with protocol %1"
msgstr "Ci protocole ci ni permet nén do candjî les atributs des fitchîs: %1"

#: kio/global.cpp:414
msgid "Using sub-URLs with %1 is not supported"
msgstr "L' uzance di sor-URL avou %1 n' est nén sopoirté"

#: kio/global.cpp:416
#, c-format
msgid "Multiple get is not supported with protocol %1"
msgstr "Li protocole %1 ni sopoite nén di pus d' èn aberwetaedje d' on côp."

#: kio/global.cpp:418
msgid "Protocol %1 does not support action %2"
msgstr "Li protocole %1 ni sopoite nén l' accion %2"

#: kio/global.cpp:438 kio/global.cpp:520
msgid "(unknown)"
msgstr "(nén cnoxhou)"

#: kio/global.cpp:450
msgid "<b>Technical reason</b>: "
msgstr "<b>Råjhon tecnike</b>: "

#: kio/global.cpp:451
msgid "</p><p><b>Details of the request</b>:"
msgstr "</p><p><b>Kitaeyaedje del dimande</b>:"

#: kio/global.cpp:452
msgid "</p><ul><li>URL: %1</li>"
msgstr "</p><ul><li>Hårdêye: %1</li>"

#: kio/global.cpp:454
msgid "<li>Protocol: %1</li>"
msgstr "<li>Protocole: %1</li>"

#: kio/global.cpp:456
msgid "<li>Date and time: %1</li>"
msgstr "<li>Date et eure: %1</li>"

#: kio/global.cpp:457
msgid "<li>Additional information: %1</li></ul>"
msgstr "<li>Co d' pus d' informåcion: %1</li></ul>"

#: kio/global.cpp:459
msgid "<p><b>Possible causes</b>:</p><ul><li>"
msgstr "<p><b>Possibès cåzes</b>:</p><ul><li>"

#: kio/global.cpp:464
msgid "<p><b>Possible solutions</b>:</p><ul><li>"
msgstr "<p><b>Possibès rexhowes</b>:</p><ul><li>"

#: kio/global.cpp:530
msgid ""
"Contact your appropriate computer support system, whether the system "
"administrator, or technical support group for further assistance."
msgstr ""
"Alez vey l' aidance tecnike. Ça pout esse li manaedjeu do sistinme ou des "
"djins metous po vs aidî. Zels vos denront on côp di spale po v' rexhe li "
"cou foû des strons."

#: kio/global.cpp:533
msgid "Contact the administrator of the server for further assistance."
msgstr "Alez vey li manaedjeu do sierveu po vs é aidî."

#: kio/global.cpp:536
msgid "Check your access permissions on this resource."
msgstr "Waitîz vos droet d' eployî cisse rissource chal."

#: kio/global.cpp:537
msgid ""
"Your access permissions may be inadequate to perform the requested operation "
"on this resource."
msgstr ""
"Ça s' pôreut bén k' vos n' årîz nén les droets k' i fåt po fé çoula "
"avou cisse rissource ci."

#: kio/global.cpp:539
msgid "The file may be in use (and thus locked) by another user or application."
msgstr ""
"Ça s' pôreut k' èn uzeu ou on programe eploye ci fitchî la pol moumint, "
"et k' i soeye eclawé."

#: kio/global.cpp:541
msgid ""
"Check to make sure that no other application or user is using the file or "
"has locked the file."
msgstr ""
"Waitîz s' i gn a nén èn ôte uzeu ou programe ki s' sieve di ç' fitchî "
"la pol moumint et ki, do côp, l' a-st eclawé."

#: kio/global.cpp:543
msgid "Although unlikely, a hardware error may have occurred."
msgstr ""
"Ca bén k' ci n' est nén probåbe, ça pôreut esse eto ene aroke dins "
"voste éndjole."

#: kio/global.cpp:545
msgid "You may have encountered a bug in the program."
msgstr "Vos avoz motoit tcheyou so on bug dins l' programe."

#: kio/global.cpp:546
msgid ""
"This is most likely to be caused by a bug in the program. Please consider "
"submitting a full bug report as detailed below."
msgstr ""
"C' est dandjureu on bug dins l' programe les cåzes. Merci do sondjî a-z "
"evoyî on rapoirt di bug come siplikî vaici å dzo."

#: kio/global.cpp:548
msgid ""
"Update your software to the latest version. Your distribution should provide "
"tools to update your software."
msgstr ""
"Metoz vosse programe a djoû avou l' dierinne modêye. Vosse distribucion a "
"seur des usteyes po vs aidî a mete vos programe a djoû."

#: kio/global.cpp:550
msgid ""
"When all else fails, please consider helping the KDE team or the third party "
"maintainer of this software by submitting a high quality bug report. If the "
"software is provided by a third party, please contact them directly. "
"Otherwise, first look to see if the same bug has been submitted by someone "
"else by searching at the <a href=\"http://bugs.kde.org/\">KDE bug reporting "
"website</a>. If not, take note of the details given above, and include them "
"in your bug report, along with as many other details as you think might help."
msgstr ""
"S' i gn a tot k' a fwait berwete, merci do sondjî a-z aidî l' ekipe KDE ou "
"li mintneu do programe tot-z evoyant on bon rapoirt di bug. Si vs avoz avu "
"l' programe d' èn ôte costé, evoyîz vosse rapoirt tot droet vaila. "
"Sinon, po cmincî, waitîz s' i gn a nén 'ne sakî d' ôte k' a ddja evoyî "
"on rapoirt sol minme bug. Vos l' poloz saveur tot cachant après dins li<a "
"href=\"http://bugs.kde.org/\">'KDE bug reporting website'</a>. Si l' bug n' "
"î est nén co, lejhoz les racsegnmints å dzeu eyet metoz les dvins vosse "
"rapoirt di bug, avou tos les ôtes racsegnmints ki pôrént aidî a vosse "
"shonnance."

#: kio/global.cpp:558
msgid "There may have been a problem with your network connection."
msgstr ""
"Ça s' pôreut k' gn åreut åk ki n' va nén dins vosse raloyaedje al "
"rantoele."

#: kio/global.cpp:561
msgid ""
"There may have been a problem with your network configuration. If you have "
"been accessing the Internet with no problems recently, this is unlikely."
msgstr ""
"Ça s' pôreut k' i gn åreut åk ki n' va nén avou l' apontiaedje del "
"rantoele. Portant, si vs n' avoz avu nole rujhe po-z eployî Internet "
"dierinnmint, ci n' est dandjureu nén çoula."

#: kio/global.cpp:564
msgid ""
"There may have been a problem at some point along the network path between "
"the server and this computer."
msgstr ""
"Ça s' pôreut k' i gn åreut åk ki n' va nén dins vosse rantoele, ene "
"sadju inte li sierveu eyet ciste éndjole ci."

#: kio/global.cpp:566
msgid "Try again, either now or at a later time."
msgstr "Sayîz co 'ne feye, asteure ou pus tård."

#: kio/global.cpp:567
msgid "A protocol error or incompatibility may have occurred."
msgstr ""
"Ça s' pôreut k' åk n' a nén stî e protocole ou k' i n' est nén "
"amishtåve."

#: kio/global.cpp:568
msgid "Ensure that the resource exists, and try again."
msgstr "Waitîz si li rsource egzistêye, adon rsayîz."

#: kio/global.cpp:569
msgid "The specified resource may not exist."
msgstr "Ça s' pôreut ki li rsource ki vos djhoz n' egzistêye nén."

#: kio/global.cpp:570
msgid "You may have incorrectly typed the location."
msgstr "Ça s' pôreut k' vos n' årîz nén tapé l' eplaeçmint comifåt."

#: kio/global.cpp:571
msgid "Double-check that you have entered the correct location and try again."
msgstr "Waitîz a deus côps si vs avoz tapé l' bon eplaeçmint.  Adon, rissayîz."

#: kio/global.cpp:573
msgid "Check your network connection status."
msgstr "Waitîz li statut di vosse raloyaedje al rantoele."

#: kio/global.cpp:577
msgid "Cannot Open Resource For Reading"
msgstr "Dji n' sai drovi li rsource pol lére."

#: kio/global.cpp:578
msgid ""
"This means that the contents of the requested file or directory "
"<strong>%1</strong> could not be retrieved, as read access could not be "
"obtained."
msgstr ""
"Ça vout dire ki dji n' a savu aler rapexhî çou k' i gn a dvins li fitchî "
"ou li ridant<strong>%1</strong>, ca dji n' aveu nén l' droet do lére."

#: kio/global.cpp:581
msgid "You may not have permissions to read the file or open the directory."
msgstr "Téle feye n' avoz nén l' droet do lére li fitchî ou do drovi li ridant."

#: kio/global.cpp:587
msgid "Cannot Open Resource For Writing"
msgstr "Dji n' sai drovi li rsource po scrire divins."

#: kio/global.cpp:588
msgid ""
"This means that the file, <strong>%1</strong>, could not be written to as "
"requested, because access with permission to write could not be obtained."
msgstr ""
"Ça vout dire ki dji n' sai scrire e fitchî <strong>%1</strong>, come vos "
"l' avoz dmandé, ca vos n' avoz nén l' droet."

#: kio/global.cpp:596
msgid "Cannot Initiate the %1 Protocol"
msgstr "Dji n' sai enonder li protocole %1."

#: kio/global.cpp:597
msgid "Unable to Launch Process"
msgstr "Nén possibe d' enonder li protocole."

#: kio/global.cpp:598
msgid ""
"The program on your computer which provides access to the "
"<strong>%1</strong> protocol could not be started. This is usually due to "
"technical reasons."
msgstr ""
"Dji n' sai enonder li programe so voste éndjole ki v' permet d' eployî li "
"protocole<strong>%1</strong>"
". Å pus sovint, c' est ene sacwè di tecnike ki n' va nén."

#: kio/global.cpp:601
msgid ""
"The program which provides compatibility with this protocol may not have "
"been updated with your last update of KDE. This can cause the program to be "
"incompatible with the current version and thus not start."
msgstr ""
"Motoit ki l' programe k' est amishtåve avou ci protocole la n' a nén stî "
"metou a djoû e minme tins ki KDE.  Do côp, ça s' pôreut ki l' programe "
"ni våye nén bén avou vosse modêye et k' i n' s' enonde nén."

#: kio/global.cpp:609
msgid "Internal Error"
msgstr "Divintrinne aroke"

#: kio/global.cpp:610
msgid ""
"The program on your computer which provides access to the "
"<strong>%1</strong> protocol has reported an internal error."
msgstr ""
"Dji n' sai enonder li programe so voste éndjole ki v' permet d' eployî li "
"protocole<strong>%1</strong> dit k' i gn a 'ne divintrinne aroke."

#: kio/global.cpp:618
msgid "Improperly Formatted URL"
msgstr "URL må basti."

#: kio/global.cpp:619
msgid ""
"The <strong>U</strong>niform <strong>R</strong>esource "
"<strong>L</strong>ocator (URL) that you entered was not properly formatted. "
"The format of a URL is generally as "
"follows:"
"<blockquote><strong>"
"protocol://user:password@www.example.org:port/directory/filename.extension?qu"
"ery=value</strong></blockquote>"
msgstr ""
"L' URL (<strong>U</strong>niform <strong>R</strong>esource "
"<strong>L</strong>ocator) ki vs avoz dné n' est nén bén bati. "
"Normålmint, èn URL rishonne a "
"çouci:"
"<blockquote><strong>"
"protocol://user:password@www.example.org:port/directory/filename.extension?qu"
"ery=value</strong></blockquote>"

#: kio/global.cpp:628
#, c-format
msgid "Unsupported Protocol %1"
msgstr "Protocole %1 nén sopoirté"

#: kio/global.cpp:629
msgid ""
"The protocol <strong>%1</strong> is not supported by the KDE programs "
"currently installed on this computer."
msgstr ""
"Li protocole <strong>%1</strong> n' est nén sopoirté påzès programes "
"KDE ki sont-st astalés pol moumint so l' éndjole."

#: kio/global.cpp:632
msgid "The requested protocol may not be supported."
msgstr "Ça s' pôreut ki l' protocole ki vs avoz dmandé n' est nén sopoirté."

#: kio/global.cpp:633
msgid ""
"The versions of the %1 protocol supported by this computer and the server "
"may be incompatible."
msgstr ""
"Ça s' pôreut k' les modêyes do protocole %1 sopoirtêye pa çt éndjole "
"ci eyet l' sierveu n' seuyexhe nén amishtåve."

#: kio/global.cpp:635
msgid ""
"You may perform a search on the Internet for a KDE program (called a "
"kioslave or ioslave) which supports this protocol. Places to search include "
"<a href=\"http://apps.kde.com/\">http://apps.kde.com/</a> and <a "
"href=\"http://freshmeat.net/\">http://freshmeat.net/</a>."
msgstr ""
"Vos poloz cachî so l' Internet après on programe KDE (lomé kioslave ou "
"ioslave) ki sopoite ci protocole ci. Les plaeces k' il î fåt cweri sont<a "
"href=\"http://apps.kde.com/\">http://apps.kde.com/</a> eyet <a "
"href=\"http://freshmeat.net/\">http://freshmeat.net/</a>."

#: kio/global.cpp:644
msgid "URL Does Not Refer to a Resource."
msgstr "Li hårdêye ni s' rapoite a nole rissource."

#: kio/global.cpp:645
msgid "Protocol is a Filter Protocol"
msgstr "Ci protocole ci est on protocole di passaedje."

#: kio/global.cpp:646
msgid ""
"The <strong>U</strong>niform <strong>R</strong>esource "
"<strong>L</strong>ocator (URL) that you entered did not refer to a specific "
"resource."
msgstr ""
"L' URL (<strong>U</strong>niform <strong>R</strong>esource "
"<strong>L</strong>ocator) ki vs avoz dné ni s' rapoite a nole metowe "
"rissource."

#: kio/global.cpp:649
msgid ""
"KDE is able to communicate through a protocol within a protocol; the "
"protocol specified is only for use in such situations, however this is not "
"one of these situations. This is a rare event, and is likely to indicate a "
"programming error."
msgstr ""
"KDE est capåbe di s' fé etinde pa on protocole divins 'n ôte protocole. "
"Li protocole ki vos djhoz sieve dins des cas insi, mins ci n' est nén l' "
"cas vaici.  Ça n' duvreut ariver ki rålmint et, do côp, c' est motoit ene "
"biestreye di programaedje."

#: kio/global.cpp:657
#, c-format
msgid "Unsupported Action: %1"
msgstr "Accion nén sopoirtêye: %1"

#: kio/global.cpp:658
msgid ""
"The requested action is not supported by the KDE program which is "
"implementing the <strong>%1</strong> protocol."
msgstr ""
"L' accion k' vos avoz dmandé n' est nén sopoirtêye do programe KDE ki met "
"èn ouve li protocole <strong>%1</strong>."

#: kio/global.cpp:661
msgid ""
"This error is very much dependent on the KDE program. The additional "
"information should give you more information than is available to the KDE "
"input/output architecture."
msgstr ""
"Ciste aroke la tént foirt å programe KDE.  Les informåcions d' rawete vos "
"duvrént dner di pus d' racsegnes ki çou k' i gn a moyén d' aveur avou les "
"intrêyes et les sôrteyes di  KDE."

#: kio/global.cpp:664
msgid "Attempt to find another way to accomplish the same outcome."
msgstr "Sayîz do trover ene ôte façon do-z abouti å minme rizultat."

#: kio/global.cpp:669
msgid "File Expected"
msgstr "I faleut on fitchî"

#: kio/global.cpp:670
msgid ""
"The request expected a file, however the directory <strong>%1</strong> was "
"found instead."
msgstr ""
"Avou vosse dimande, i faleut  on fitchî. Mins c' est l' ridant "
"<strong>%1</strong> k' a stî rshû el plaece."

#: kio/global.cpp:672
msgid "This may be an error on the server side."
msgstr "Ça pôreut esse ene sacwè ki n' va nén do costé do sierveu."

#: kio/global.cpp:677
msgid "Directory Expected"
msgstr "I faleut on ridant"

#: kio/global.cpp:678
msgid ""
"The request expected a directory, however the file <strong>%1</strong> was "
"found instead."
msgstr ""
"Avou vosse dimande, i faleut  on ridant. Mins c' est l' fitchî "
"<strong>%1</strong> k' a stî rshû el plaece."

#: kio/global.cpp:685
msgid "File or Directory Does Not Exist"
msgstr "Li fitchî ou li ridant n' egzistêye nén."

#: kio/global.cpp:686
msgid "The specified file or directory <strong>%1</strong> does not exist."
msgstr "Li fitchî ou li ridant dné <strong>%1</strong> n' egzistêye nén."

#: kio/global.cpp:694
msgid ""
"The requested file could not be created because a file with the same name "
"already exists."
msgstr "Dji n' sai fé l' fitchî dmandé, ca gn a ddja èn ôte k' a l' minme no."

#: kio/global.cpp:696
msgid "Try moving the current file out of the way first, and then try again."
msgstr "Sayîz do bodjî l' fitchî k' egzistêye dedja po cmincî.  Adon, rissayîz."

#: kio/global.cpp:698
msgid "Delete the current file and try again."
msgstr "Disfacer li fitchî do moumint et sayî co on côp."

#: kio/global.cpp:699
msgid "Choose an alternate filename for the new file."
msgstr "Tchoezixhoz èn ôte no pol novea fitchî."

#: kio/global.cpp:704
msgid ""
"The requested directory could not be created because a directory with the "
"same name already exists."
msgstr "Dji n' sai fé l' ridant dmandé, ca gn a ddja èn ôte k' a l' minme no."

#: kio/global.cpp:706
msgid "Try moving the current directory out of the way first, and then try again."
msgstr "Sayîz do bodjî l' ridant k' egzistêye dedja po cmincî.  Adon, rissayîz."

#: kio/global.cpp:708
msgid "Delete the current directory and try again."
msgstr "Disfacez l' ridant. Adon, rissayîz."

#: kio/global.cpp:709
msgid "Choose an alternate name for the new directory."
msgstr "Tchoezixhoz èn ôte no pol novea ridant."

#: kio/global.cpp:713
msgid "Unknown Host"
msgstr "Lodjoe nén cnoxhou"

#: kio/global.cpp:714
msgid ""
"An unknown host error indicates that the server with the requested name, "
"<strong>%1</strong>, could not be located on the Internet."
msgstr ""
"Ene aroke <strong>Lodjoe nén cnoxhou</strong>"
" vout dire ki l' sierveu  avou l' no k' vos avoz dmandé "
"(<strong>%1</strong> n' a nén stî trové avå l' daegntoele."

#: kio/global.cpp:717
msgid "The name that you typed, %1, may not exist: it may be incorrectly typed."
msgstr ""
"Kéke feye ki li no k' vos avoz tapé (%1) n' egzistêye nén, ou bén k' "
"vos l' avoz må tapé."

#: kio/global.cpp:724
msgid "Access Denied"
msgstr "Disfinse di moussî."

#: kio/global.cpp:725
msgid "Access was denied to the specified resource, <strong>%1</strong>."
msgstr "Vos n' avoz nén l' droet d' eployî li rsource <strong>%1</strong>."

#: kio/global.cpp:727 kio/global.cpp:943
msgid "You may have supplied incorrect authentication details or none at all."
msgstr ""
"Motoit avoz dné des informåcions d' aveurixhmint ki n' sont nén djusses, "
"ou nole."

#: kio/global.cpp:729 kio/global.cpp:945
msgid "Your account may not have permission to access the specified resource."
msgstr ""
"Motoit k' vosse conte ni v' dene nén l' droet d' eployî li rsource ki vos "
"djhoz."

#: kio/global.cpp:731 kio/global.cpp:947 kio/global.cpp:959
msgid ""
"Retry the request and ensure your authentication details are entered "
"correctly."
msgstr "Sayîz do ridmander et waitîz k' vos avoz tapé totafwait comifåt."

#: kio/global.cpp:737
msgid "Write Access Denied"
msgstr "Vos n' avoz nén les droets po scrire."

#: kio/global.cpp:738
msgid ""
"This means that an attempt to write to the file <strong>%1</strong> was "
"rejected."
msgstr ""
"Ça vout dire k' ene såye po scrire e fitchî<strong>%1</strong> n' a nén "
"adiercî."

#: kio/global.cpp:745
msgid "Unable to Enter Directory"
msgstr "Dji n' sai moussî e ridant"

#: kio/global.cpp:746
msgid ""
"This means that an attempt to enter (in other words, to open) the requested "
"directory <strong>%1</strong> was rejected."
msgstr ""
"Ça vout dire k' ene såye po moussî e ridant dmandé (ou l' drovi) "
"<strong>%1</strong> n' a nén adiercî."

#: kio/global.cpp:754
msgid "Directory Listing Unavailable"
msgstr "Dji n' sai håyner l' djivêye di l' ådvins do ridant."

#: kio/global.cpp:755
msgid "Protocol %1 is not a Filesystem"
msgstr "Li protocole %1 n' est nén on sistinme di fitchî."

#: kio/global.cpp:756
msgid ""
"This means that a request was made which requires determining the contents "
"of the directory, and the KDE program supporting this protocol is unable to "
"do so."
msgstr ""
"Ça vout dire ki vs avoz fwait 'ne dimande ki cache a saveur çou k' i gn a "
"å dvins d' on ridant, mins ki l' programe KDE ki sopoite ci protocole la n' "
"a nén parvinou al fé."

#: kio/global.cpp:764
msgid "Cyclic Link Detected"
msgstr "Betchfessî loyén di trové"

#: kio/global.cpp:765
msgid ""
"UNIX environments are commonly able to link a file or directory to a "
"separate name and/or location. KDE detected a link or series of links that "
"results in an infinite loop - i.e. the file was (perhaps in a roundabout "
"way) linked to itself."
msgstr ""
"Normålmint, les evironmints UNIX sont capåbe d' aloyî on fitchî ou on "
"ridant a èn ôte no ou èn ôte eplaeçmint.  KDE a trové on loyén ou ene "
"séreye di loyéns ki sont betchfessîs, ça vout dire ki l' fitchî est "
"aloyî a lu minme (kéke feye nén tot droet)."

#: kio/global.cpp:769 kio/global.cpp:791
msgid ""
"Delete one part of the loop in order that it does not cause an infinite "
"loop, and try again."
msgstr ""
"Disfacez on boket ou l' ôte po n' pus k' les fitchîs seuyexhe "
"betchfessîs.  Adon, rissayîz."

#: kio/global.cpp:778
msgid "Request Aborted By User"
msgstr "Dimande annulêye pa l' uzeu"

#: kio/global.cpp:779 kio/global.cpp:1072
msgid "The request was not completed because it was aborted."
msgstr "Li dmande n' a nén abouti, ca elle a stî annulêye."

#: kio/global.cpp:781 kio/global.cpp:975 kio/global.cpp:1074
msgid "Retry the request."
msgstr "Rissayîz li dmande."

#: kio/global.cpp:785
msgid "Cyclic Link Detected During Copy"
msgstr "Dj' a trové on betchfessî loyén come dji fjheu l' copiaedje"

#: kio/global.cpp:786
msgid ""
"UNIX environments are commonly able to link a file or directory to a "
"separate name and/or location. During the requested copy operation, KDE "
"detected a link or series of links that results in an infinite loop - i.e. "
"the file was (perhaps in a roundabout way) linked to itself."
msgstr ""
"Normålmint, les evironmints UNIX sont capåbe d' aloyî on fitchî ou on "
"ridant a èn ôte no ou èn ôte eplaeçmint. Come i fjheut l' copiaedje ki "
"vs avoz dmandé, KDE a trové on loyén ou ene séreye di loyéns ki sont "
"betchfessîs, ça vout dire ki l' fitchî est aloyî a lu minme (kéke feye "
"nén tot droet)."

#: kio/global.cpp:796
msgid "Could Not Create Network Connection"
msgstr "Dji n' sai fé l' raloyaedje rantoele"

#: kio/global.cpp:797
msgid "Could Not Create Socket"
msgstr "Dji n' sai fé l' soket"

#: kio/global.cpp:798
msgid ""
"This is a fairly technical error in which a required device for network "
"communications (a socket) could not be created."
msgstr ""
"C' est ene aroke foirt tecnike: i gn a nén avu moyén d' emantchîene "
"usteye k' i fåt po les rantoeles (on soket)."

#: kio/global.cpp:800 kio/global.cpp:913 kio/global.cpp:924 kio/global.cpp:933
msgid ""
"The network connection may be incorrectly configured, or the network "
"interface may not be enabled."
msgstr ""
"Ça s' pôreut ki l' raloyaedje a l' rantoele ni soeye nén bén apontieye "
"ou ki l' eterface del rantoele ni soeye nén èn alaedje."

#: kio/global.cpp:806
msgid "Connection to Server Refused"
msgstr "Raloyaedje å sierveu rifuzé"

#: kio/global.cpp:807
msgid ""
"The server <strong>%1</strong> refused to allow this computer to make a "
"connection."
msgstr "Li sierveu <strong>%1</strong> a rfuzé ki ciste éndjole ci si raloye."

#: kio/global.cpp:809
msgid ""
"The server, while currently connected to the Internet, may not be configured "
"to allow requests."
msgstr ""
"Ça s' pôreut ki ç' sierveu la, minme s' il est raloyî al daegntoele ni "
"soeye nén apontyî po s' leyî raloyî."

#: kio/global.cpp:811
msgid ""
"The server, while currently connected to the Internet, may not be running "
"the requested service (%1)."
msgstr ""
"Ca bén ki l' sierveu est raloyî al daegntoele pol moumint, ça s' pôreut "
"ki l' siervice dimandé ni toûne nén dsu pol moumint (%1)."

#: kio/global.cpp:813
msgid ""
"A network firewall (a device which restricts Internet requests), either "
"protecting your network or the network of the server, may have intervened, "
"preventing this request."
msgstr ""
"Kéke feye k' i i gn a on côpe feu pol rantoele (ç.v.d. èn éndjin ki "
"rastrind les dmandes Internet) k' a espaitchî cisse dimande di passer, "
"soeye-t i so vosse rantoele ou sol rantoele do sierveu."

#: kio/global.cpp:820
msgid "Connection to Server Closed Unexpectedly"
msgstr "Li raloyaedje å sierveu a stî côpé sins prévni"

#: kio/global.cpp:821
msgid ""
"Although a connection was established to <strong>%1</strong>"
", the connection was closed at an unexpected point in the communication."
msgstr ""
"Ca bén k' i gn a-st avu on raloyaedje di fwait a <strong>%1</strong>, li "
"raloyaedje a stî côpé par après d' ene façon inatindowe."

#: kio/global.cpp:824
msgid ""
"A protocol error may have occurred, causing the server to close the "
"connection as a response to the error."
msgstr ""
"Kéke feye gn a-t i avu 'ne aroke e protocole.  Do côp, li sierveu årè "
"côpé l' raloyaedje come response a l' aroke."

#: kio/global.cpp:830
msgid "URL Resource Invalid"
msgstr "Rissource d' URL nén valide"

#: kio/global.cpp:831
msgid "Protocol %1 is not a Filter Protocol"
msgstr "Li protocole %1 n' est nén on protocole di passaedje."

#: kio/global.cpp:832
msgid ""
"The <strong>U</strong>niform <strong>R</strong>esource "
"<strong>L</strong>ocator (URL) that you entered did not refer to a valid "
"mechanism of accessing the specific resource, <strong>%1%2</strong>."
msgstr ""
"L' URL (<strong>U</strong>niform <strong>R</strong>esource "
"<strong>L</strong>ocator) ki vs avoz dné ni corespond nén a on mecanisse "
"valåbe po-z eployî cisse rissource la <strong>%1%2</strong>."

#: kio/global.cpp:837
msgid ""
"KDE is able to communicate through a protocol within a protocol. This "
"request specified a protocol be used as such, however this protocol is not "
"capable of such an action. This is a rare event, and is likely to indicate a "
"programming error."
msgstr ""
"KDE est capåve di comuniker pa on protocole divins èn ôte protocole. Li "
"protocole dimandé n' est eployî ki dins des cas insi, mins ci n' est "
"djustumint nén l' cas vaici. I s' adjixh d' åk di råle, seur ene sacwè "
"ki n' va nén e programaedje."

#: kio/global.cpp:845
msgid "Unable to Initialize Input/Output Device"
msgstr "Nén moyén d' enonder l' éndjin des intrêyes et des sôrteyes"

#: kio/global.cpp:846
msgid "Could Not Mount Device"
msgstr "Dji n' sai monter l' éndjin"

#: kio/global.cpp:847
msgid ""
"The requested device could not be initialized (\"mounted\"). The reported "
"error was: <strong>%1</strong>"
msgstr ""
"Gn a nén avu moyén d' enonder (\"monter\") l' éndjin k' vos avoz dmandé. "
"L' aroke rapoirtêye est: <strong>%1</strong>"

#: kio/global.cpp:850
msgid ""
"The device may not be ready, for example there may be no media in a "
"removable media device (i.e. no CD-ROM in a CD drive), or in the case of a "
"peripheral/portable device, the device may not be correctly connected."
msgstr ""
"Motoit ki l' éndjin n' est nén presse. Par egzimpe, ça s' pôreut k' i gn "
"åye nou sopoirt dins èn éndjin k' endè prind (metans: pont d' CD-ROM "
"dins 'ne léjhrece).  Ou bén, si c' est èn aidant éndjin ou èn axhlåve "
"éndjin, kéke feye k' i n' est bén raloyî."

#: kio/global.cpp:854
msgid ""
"You may not have permissions to initialize (\"mount\") the device. On UNIX "
"systems, often system administrator privileges are required to initialize a "
"device."
msgstr ""
"Motoit n' avoz nén l' droet d' enonder (\"monter\") l' éndjin.  So les "
"sistinmes UNIX, i v' fåt sovint les droets d' on manaedjeu do sistinme po-z "
"enonder èn éndjin."

#: kio/global.cpp:858
msgid ""
"Check that the device is ready; removable drives must contain media, and "
"portable devices must be connected and powered on.; and try again."
msgstr ""
"Verifyîz ki l' éndjin est presse. Les léjhrece, i fåt on sopoirt divins. "
" Les axhlåves éndjins dvèt esse raloyîs comifåt et aloumé.  Sayîz co "
"'ne feye."

#: kio/global.cpp:864
msgid "Unable to Uninitialize Input/Output Device"
msgstr "Nén moyén do dliberer l' éndjin des intrêyes eyet des sôrteyes"

#: kio/global.cpp:865
msgid "Could Not Unmount Device"
msgstr "Dji n' sai dismonter l' éndjin"

#: kio/global.cpp:866
msgid ""
"The requested device could not be uninitialized (\"unmounted\"). The "
"reported error was: <strong>%1</strong>"
msgstr ""
"Gn a nén avu moyén d' diliberer (\"dismonter\") l' éndjin k' vos avoz "
"dmandé. L' aroke rapoirtêye est: <strong>%1</strong>"

#: kio/global.cpp:869
msgid ""
"The device may be busy, that is, still in use by another application or "
"user. Even such things as having an open browser window on a location on "
"this device may cause the device to remain in use."
msgstr ""
"Ça s' pôreut ki l' éndjin sereut ocupé, ç.v.d. k' èn ôte programe ou "
"èn ôte uzeu s' e sieve co pol moumint.  Ça pout esse, metans, on purnea "
"d' on betchteu å lådje so 'n eplaeçmint loyî a çt éndjin la"

#: kio/global.cpp:873
msgid ""
"You may not have permissions to uninitialize (\"unmount\") the device. On "
"UNIX systems, system administrator privileges are often required to "
"uninitialize a device."
msgstr ""
"Motoit n' avoz nén l' droet do dliberer (\"dismonter\") l' éndjin.  So les "
"sistinmes UNIX, i v' fåt sovint les droets d' on manaedjeu do sistinme po "
"dliberer èn éndjin."

#: kio/global.cpp:877
msgid "Check that no applications are accessing the device, and try again."
msgstr ""
"Loukîz s' i gn a nén des programes k' eployèt çt éndjin la pol moumint. "
"Adon rsayîz."

#: kio/global.cpp:882
msgid "Cannot Read From Resource"
msgstr "Dji n' sai lére l' ådvins del rissource"

#: kio/global.cpp:883
msgid ""
"This means that although the resource, <strong>%1</strong>, was able to be "
"opened, an error occurred while reading the contents of the resource."
msgstr ""
"Ça vout dire k' i gn a-st avu moyén do drovi li rsource "
"(<strong>%1</strong>"
"), åk n' a nén stî come dji sayive do lére çou k' i gn a å dvins."

#: kio/global.cpp:886
msgid "You may not have permissions to read from the resource."
msgstr "Motoit n' avoz nén l' droet po lére çou k' i gn a å dvins del rissource."

#: kio/global.cpp:895
msgid "Cannot Write to Resource"
msgstr "Dji n' sai scrire dins li rsource"

#: kio/global.cpp:896
msgid ""
"This means that although the resource, <strong>%1</strong>, was able to be "
"opened, an error occurred while writing to the resource."
msgstr ""
"Ça vout dire k' i gn a-st avu moyén do drovi li rsource "
"(<strong>%1</strong>), åk n' a nén stî come dji sayive do scrire å dvins."

#: kio/global.cpp:899
msgid "You may not have permissions to write to the resource."
msgstr "Motoit n' avoz nén l' droet po scrire divins l' rissource."

#: kio/global.cpp:908 kio/global.cpp:919
msgid "Could Not Listen for Network Connections"
msgstr "Dji n' sai schoûter les raloyaedjes al rantoele"

#: kio/global.cpp:909
msgid "Could Not Bind"
msgstr "Nén moyén do loyî"

#: kio/global.cpp:910 kio/global.cpp:921
msgid ""
"This is a fairly technical error in which a required device for network "
"communications (a socket) could not be established to listen for incoming "
"network connections."
msgstr ""
"C' est ene aroke foirt tecnike: i gn a nén avu moyén d' emantchîene "
"usteye k' i fåt po les rantoeles (on soket) et po saveur schoûter les "
"raloyaedjes po-z intrer dins l' rantoele."

#: kio/global.cpp:920
msgid "Could Not Listen"
msgstr "Dji n' sai schoûter"

#: kio/global.cpp:930
msgid "Could Not Accept Network Connection"
msgstr "Nén moyén d' accepter l' raloyaedje al rantoele"

#: kio/global.cpp:931
msgid ""
"This is a fairly technical error in which an error occurred while attempting "
"to accept an incoming network connection."
msgstr ""
"C' est ene aroke foirt tecnike: i gn a nén avu moyén d' accepter on "
"raloyaedje po-z intrer dins l' rantoele."

#: kio/global.cpp:935
msgid "You may not have permissions to accept the connection."
msgstr "Motoit k' vos n' avoz nén les droets po-z accepter on raloyaedje."

#: kio/global.cpp:940
#, c-format
msgid "Could Not Login: %1"
msgstr "Dji n' parvén nén a moussî: %1"

#: kio/global.cpp:941
msgid "An attempt to login to perform the requested operation was unsuccessful."
msgstr ""
"Li såye po rintrer el session po fé l' operåcion dmandêye n' a nén "
"adiercî."

#: kio/global.cpp:952
msgid "Could Not Determine Resource Status"
msgstr "Dji n' sai dire l' etat del rissource"

#: kio/global.cpp:953
msgid "Could Not Stat Resource"
msgstr "Dji n' sai analijhî li rsource"

#: kio/global.cpp:954
msgid ""
"An attempt to determine information about the status of the resource "
"<strong>%1</strong>, such as the resource name, type, size, etc., was "
"unsuccessful."
msgstr ""
"Ene såye po vey cwè å dfait del rissource <strong>%1</strong>"
" (metans: si no, si sôre, si grandeu, evnd.) a fwait berwete."

#: kio/global.cpp:957
msgid "The specified resource may not have existed or may not be accessible."
msgstr ""
"Kéke feye ki cisse rissource la n' egzistêye nén, ou don bén dji nel sai "
"lére."

#: kio/global.cpp:965
msgid "Could Not Cancel Listing"
msgstr "Dji n' sai annuler li listaedje"

#: kio/global.cpp:966
msgid "FIXME: Document this"
msgstr "A FÉ: documinter çouchal"

#: kio/global.cpp:970
msgid "Could Not Create Directory"
msgstr "Dji n' sai fé l' ridant"

#: kio/global.cpp:971
msgid "An attempt to create the requested directory failed."
msgstr "Ene såye po fé l' ridant dmandé a fwait berwete"

#: kio/global.cpp:972
msgid "The location where the directory was to be created may not exist."
msgstr ""
"Kéke feye ki l' eplaeçmint eyu çk' i faleut fé l' ridant n' egzistêye "
"nén."

#: kio/global.cpp:979
msgid "Could Not Remove Directory"
msgstr "Dji n' sai oister l' ridant"

#: kio/global.cpp:980
msgid "An attempt to remove the specified directory, <strong>%1</strong>, failed."
msgstr "Ene såye po oister l' ridant <strong>%1</strong> a fwait berwete."

#: kio/global.cpp:982
msgid "The specified directory may not exist."
msgstr "Kéke feye ki ç' ridant la n' egzistêye nén."

#: kio/global.cpp:983
msgid "The specified directory may not be empty."
msgstr "Kéke feye ki ç' ridant la n' est nén vude."

#: kio/global.cpp:986
msgid "Ensure that the directory exists and is empty, and try again."
msgstr "Loukîz si l' ridant est bén vude. Adon, rissayîz."

#: kio/global.cpp:991
msgid "Could Not Resume File Transfer"
msgstr "Dji n' a savu rataker a berweter l' fitchî"

#: kio/global.cpp:992
msgid ""
"The specified request asked that the transfer of file <strong>%1</strong>"
" be resumed at a certain point of the transfer. This was not possible."
msgstr ""
"Shuvant li dmande, li berwetaedje do fitchî<strong>%1</strong> diveut "
"rataker a on metou pont, mins ci n' esteut nén possibe."

#: kio/global.cpp:995
msgid "The protocol, or the server, may not support file resuming."
msgstr ""
"Téle feye ki l' protocole ou l' sierveu ni permetèt nén do rataker a "
"berweter les fitchîs."

#: kio/global.cpp:997
msgid "Retry the request without attempting to resume transfer."
msgstr "Rissayî vosse dimande, sins dmander ki l' berwetaedje ratake."

#: kio/global.cpp:1002
msgid "Could Not Rename Resource"
msgstr "Dji n' a savu rlomer l' rissource."

#: kio/global.cpp:1003
msgid "An attempt to rename the specified resource <strong>%1</strong> failed."
msgstr ""
"Ene såye po rlomer li rsource specifieye <strong>%1</strong> a fwait "
"berwete."

#: kio/global.cpp:1011
msgid "Could Not Alter Permissions of Resource"
msgstr "Dji n' a savu candjî les droets so li rsource"

#: kio/global.cpp:1012
msgid ""
"An attempt to alter the permissions on the specified resource "
"<strong>%1</strong> failed."
msgstr ""
"Ene såye po candjî les droets so l' rissource specifieye "
"<strong>%1</strong> a fwait berwete."

#: kio/global.cpp:1019
msgid "Could Not Delete Resource"
msgstr "Dji n' a savu disfacer li rsource"

#: kio/global.cpp:1020
msgid "An attempt to delete the specified resource <strong>%1</strong> failed."
msgstr ""
"Ene såye po disfacer li rsource specifieye <strong>%1</strong> a fwait "
"berwete."

#: kio/global.cpp:1027
msgid "Unexpected Program Termination"
msgstr "Difén inatindowe do programe"

#: kio/global.cpp:1028
msgid ""
"The program on your computer which provides access to the "
"<strong>%1</strong> protocol has unexpectedly terminated."
msgstr ""
"Li programe di voste éndjole ki vs permet d' eployî li protocole "
"<strong>%1</strong> s' a djoké d' ene façon inatindowe."

#: kio/global.cpp:1036
msgid "Out of Memory"
msgstr "Pupont d' memwere"

#: kio/global.cpp:1037
msgid ""
"The program on your computer which provides access to the "
"<strong>%1</strong> protocol could not obtain the memory required to "
"continue."
msgstr ""
"Li programe di voste éndjole ki vs permet d' eployî li protocole "
"<strong>%1</strong> n' a nén avu tote li memwere k' il a dandjî po "
"continouwer."

#: kio/global.cpp:1045
msgid "Unknown Proxy Host"
msgstr "Procsi nén cnoxhou "

#: kio/global.cpp:1046
msgid ""
"While retrieving information about the specified proxy host, "
"<strong>%1</strong>, an Unknown Host error was encountered. An unknown host "
"error indicates that the requested name could not be located on the Internet."
msgstr ""
"Come dji sayive di rapexhî des informåcions sol procsi "
"<strong>%1</strong>, dj' a rshû on messaedje 'Lodjoe nén cnoxhou'. Ene "
"aroke insi, ça vout dire ki l' no k' vos avoz dmandé n' a nén stî trové "
"sol daegntoele."

#: kio/global.cpp:1050
msgid ""
"There may have been a problem with your network configuration, specifically "
"your proxy's hostname. If you have been accessing the Internet with no "
"problems recently, this is unlikely."
msgstr ""
"Motoit gn a-t i kéke tchoi ki n' va nén dins l' apontiaedje di vosse "
"rantoele, dandjureu li no d' lodjoe do procsi. Mins nerén, si vs avoz stî "
"sol daegntoele dins rujhes dierinnmint, ci n' est dandjureu nén çoula."

#: kio/global.cpp:1054
msgid "Double-check your proxy settings and try again."
msgstr "Riwaitîz comifåt l' apontiaedje di vosse procsi, et rsayîz."

#: kio/global.cpp:1059
msgid "Authentication Failed: Method %1 Not Supported"
msgstr "L' aveurixhmint a fwait berwete: li metôde %1 n' est nén sopoirtêye."

#: kio/global.cpp:1061
#, c-format
msgid ""
"Although you may have supplied the correct authentication details, the "
"authentication failed because the method that the server is using is not "
"supported by the KDE program implementing the protocol %1."
msgstr ""
"Ça s' pout k' vos avoz dné totes les racsegnes k' i fåt po l' "
"aveurixhmint (authentication).  Portant, l' aveurixhmint a fwait berwete "
"paski l' metôde ki l' sierveu eploye n' est nén sopoirtêye pal programe "
"KDE ki met èn ouve li protocole %1."

#: kio/global.cpp:1065
msgid ""
"Please file a bug at <a "
"href=\"http://bugs.kde.org/\">http://bugs.kde.org/</a> to inform the KDE "
"team of the unsupported authentication method."
msgstr ""
"Merci d' evoyî on rapoirt di bug a <a "
"href=\"http://bugs.kde.org/\">http://bugs.kde.org/<./a>"
" po mete l' ekipe KDE å corant k' i gn a 'ne metôde d' aveurixhmint ki n' "
"est nén sopoirtêye."

#: kio/global.cpp:1071
msgid "Request Aborted"
msgstr "Dimandêye côpêye"

#: kio/global.cpp:1078
msgid "Internal Error in Server"
msgstr "Divintrinne aroke sol sierveu"

#: kio/global.cpp:1079
msgid ""
"The program on the server which provides access to the <strong>%1</strong> "
"protocol has reported an internal error: %0."
msgstr ""
"Li programe sol sierveu ki vs permet d' eployî li protocole "
"<strong>%1</strong> rapoite k' i gn a-st avu 'ne divintrinne aroke: %0."

#: kio/global.cpp:1082
msgid ""
"This is most likely to be caused by a bug in the server program. Please "
"consider submitting a full bug report as detailed below."
msgstr ""
"C' est dandjureu on bug les cåzes, dins l' programe sol sierveu. Ci sereut "
"bén si vs evoyrîz on rapoirt di bug del façon esplikeye vaici pa dzo."

#: kio/global.cpp:1085
msgid "Contact the administrator of the server to advise them of the problem."
msgstr ""
"Atôchîz l' manaedjeu do sierveu po l' advierti k' i gn a 'ne sacwè ki n' "
"va  nén."

#: kio/global.cpp:1087
msgid ""
"If you know who the authors of the server software are, submit the bug "
"report directly to them."
msgstr ""
"Si vs savoz kî çki c' est les oteurs do programe sol sierveu, c' est co "
"mî d' elzî evoyî vosse rapoirt tot droet."

#: kio/global.cpp:1092
msgid "Timeout Error"
msgstr "Aroke di ratindaedje"

#: kio/global.cpp:1093
msgid ""
"Although contact was made with the server, a response was not received "
"within the amount of time allocated for the request as "
"follows:"
"<ul>"
"<li>Timeout for establishing a connection: %1 seconds</li>"
"<li>Timeout for receiving a response: %2 seconds</li>"
"<li>Timeout for accessing proxy servers: %3 seconds</li></ul>Please note "
"that you can alter these timeout settings in the KDE Control Center, by "
"selecting Network -> Preferences."
msgstr ""
"Ca bén k' dji m' a savu raloyî a sierveu, dji n' a rshû nole response "
"dins les tins acoirdés al dimande, c ' est a dire:"
"<ul>"
"<li> Ratindaedje po s' raloyî: %1 segondes</li>"
"<li> Ratindaedje po rshure ene response: %2 segondes</li>"
"<li> Ratindaedje po-z atôchî les sierveus procsi: %3 segondes</li> </ul> "
"Vos poloz candjî li tins di ratindaedje e l' aisse di minaedje di KDE, tot "
"tchoezixhant Rantoele -> Preferinces."

#: kio/global.cpp:1104
msgid "The server was too busy responding to other requests to respond."
msgstr "Li sierveu esteut trop ocupé a responde a des ôtès dmandes po responde."

#: kio/global.cpp:1110
msgid "Unknown Error"
msgstr "Aroke nén cnoxhowe"

#: kio/global.cpp:1111
msgid ""
"The program on your computer which provides access to the "
"<strong>%1</strong> protocol has reported an unknown error: %2."
msgstr ""
"Li programe so voste éndjole ki vs permet d' eployî li protocole "
"<strong>%1</strong> rapoite ene aroke nén ricnoxhowe: %2."

#: kio/global.cpp:1119
msgid "Unknown Interruption"
msgstr "Interompaedje nén cnoxhou"

#: kio/global.cpp:1120
msgid ""
"The program on your computer which provides access to the "
"<strong>%1</strong> protocol has reported an interruption of an unknown "
"type: %2."
msgstr ""
"Li programe so voste éndjole ki vs permet d' eployî li protocole "
"<strong>%1</strong> rapoite èn interompaedje d' ene sôre nén ricnoxhowe: "
"%2."

#: kio/global.cpp:1128
msgid "Could Not Delete Original File"
msgstr "Dji n' sai disfacer li fitchî d' oridjene"

#: kio/global.cpp:1129
msgid ""
"The requested operation required the deleting of the original file, most "
"likely at the end of a file move operation. The original file "
"<strong>%1</strong> could not be deleted."
msgstr ""
"Po fé l' operåcion dmandêye, i faleut disfacer li fitchî d' oridjene, "
"pol pus seur al difén d' on bodjaedje di fitchî. Seulmint, gn a nén avu "
"moyén do disfacer li fitchî d' oridjene <strong>%1</strong>."

#: kio/global.cpp:1138
msgid "Could Not Delete Temporary File"
msgstr "Dji n' sai disfacer li fitchî timporaire"

#: kio/global.cpp:1139
msgid ""
"The requested operation required the creation of a temporary file in which "
"to save the new file while being downloaded. This temporary file "
"<strong>%1</strong> could not be deleted."
msgstr ""
"Po fé çou k' vos avoz dmandé, i faleut fé on fitchî timporaire po-z î "
"schaper li novea fitchî tins k' dji l' aberwetéve.  Seulmint, ci fitchî "
"timporaire la, <strong>%1</strong>, i gn a nén avu moyén del disfacer."

#: kio/global.cpp:1148
msgid "Could Not Rename Original File"
msgstr "Dji n' sai rlomer l' fitchî d' oridjene"

#: kio/global.cpp:1149
msgid ""
"The requested operation required the renaming of the original file "
"<strong>%1</strong>, however it could not be renamed."
msgstr ""
"Po fé çou k' vos avoz dmandé, i faleut rlomer li fitchî d' oridjene "
"<strong>%1</strong>, mins dji n' l' a savu rlomer."

#: kio/global.cpp:1157
msgid "Could Not Rename Temporary File"
msgstr "Dji n' sai rlomer l' fitchî timporaire"

#: kio/global.cpp:1158
msgid ""
"The requested operation required the creation of a temporary file "
"<strong>%1</strong>, however it could not be created."
msgstr ""
"Po fé çou k' vos avoz dmandé, i faleut fé on fitchî timporaire: "
"<strong>%1</strong>. Seulmint, ci fitchî timporaire la,  i gn a nén avu "
"moyén del fé."

#: kio/global.cpp:1166
msgid "Could Not Create Link"
msgstr "Dji n' sai fé l' loyén"

#: kio/global.cpp:1167
msgid "Could Not Create Symbolic Link"
msgstr "Dji n' sai fé on loyén simbolike"

#: kio/global.cpp:1168
msgid "The requested symbolic link %1 could not be created."
msgstr "Dji n' a savu fé l' loyén simbolike dimandé: %1."

#: kio/global.cpp:1175
msgid "No Content"
msgstr "Rén å dvins"

#: kio/global.cpp:1180
msgid "Disk Full"
msgstr "Deure plake forrimpleye"

#: kio/global.cpp:1181
msgid ""
"The requested file <strong>%1</strong> could not be written to as there is "
"inadequate disk space."
msgstr ""
"Li fitchî k' vos avoz dmandé, <strong>%1</strong>, dji n' l' a savu "
"scrire, ca gn a nén del plaece assez sol deure plake."

#: kio/global.cpp:1183
msgid ""
"Free up enough disk space by 1) deleting unwanted and temporary files; 2) "
"archiving files to removable media storage such as CD-Recordable discs; or "
"3) obtain more storage capacity."
msgstr ""
"Vos dvoz fé del plaece. Po ça, vos poloz (1) disfacer des fitchîs "
"timporaires ou k' vos n' avoz nén mezåjhe; (2) schaper des fitchîs so des "
"bodjåves sopoirts, metans des CD eredjîstråves; (3) tirer vosse plan po-z "
"aveur di pus d' plaece."

#: kio/global.cpp:1190
msgid "Source and Destination Files Identical"
msgstr "Li fitchî sourdant eyet l' fitchî såme son les minmes"

#: kio/global.cpp:1191
msgid ""
"The operation could not be completed because the source and destination "
"files are the same file."
msgstr ""
"Gn a nén avu moyén do fé çou k' vos avoz dmandé, ca l' fitchî sourdant "
"eyet l' fitchî såme, c' est les minmes."

#: kio/global.cpp:1193
msgid "Choose a different filename for the destination file."
msgstr "Tchoezixhoz èn ôte no d' fitchî come såme."

